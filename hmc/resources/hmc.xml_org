<configuration xmlns="hybris.de/schemas/hmc/generic"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="hybris.de/schemas/hmc/generic hmc.xsd">
	<explorertree>
		<group name="catalog" expand="false" description="group.catalog.description">
			<typeref type="Textitem" position="6" description="typeref.Textitem.description" />
			<typeref type="Tips" position="7" description="typeref.Tips.description" />			   
		</group>
	</explorertree>

   <type name="SampleWizard" useselector="true">
      <organizer>
         <editor>
            <exclude>
               <exclusion attribute="owner"/>
            </exclude>
            <tab name="SampleWizard.tab1" position="0">
               <section name="SampleWizard.section1">
                  <listlayout>
                     <attribute name="productNeu" labelwidth="150" width="50" />
                     <attribute name="productList" labelwidth="150" width="250" />
                     <attribute name="categoryList" labelwidth="150" width="250" />
<!--
                     <attribute name="seconds" labelwidth="100" />
                     <attribute name="pk" labelwidth="100" />
                     <attribute name="stringList" labelwidth="100" />
                       <attribute name="unitList" labelwidth="100" /> 
-->
                  </listlayout>
               </section>
            </tab>
<!--             
            <tab name="SampleWizard.tab2" position="1">
               <section name="SampleWizard.section2">
                  <listlayout>
                     <attribute name="artikelList" labelwidth="200" />
                  </listlayout>
               </section>
            </tab>
-->
         </editor>
      </organizer>
   </type>
   <type name="NexMartExportWizard" useselector="true">
      <organizer>
         <editor>
            <exclude>
               <exclusion attribute="owner"/>
            </exclude>
            <tab name="NexMartExportWizard.tab1" position="0">
               <section name="NexMartExportWizard.section1">
                  <listlayout>
                     <attribute name="classificationsystemversionlist" labelwidth="200" />
                     <attribute name="export_categories" labelwidth="200" />
                     <attribute name="export_products" labelwidth="200" />
                  </listlayout>
               </section>
            </tab>
         </editor>
      </organizer>
   </type>


	<!-- Wera Produkt -->
	<type name="WeraProduct" mode="append" icon="/wera/images/e_weraprodukt_neu.gif">
		<organizer>
			<search mode="append">
				<condition attribute="catalogVersion" />
			</search>
			<result mode="append">
				<listview mode="replace">
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name" />
						<attribute name="catalogVersion" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview mode="replace" >
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name" />
						<attribute name="catalogVersion" />
					</itemlayout>
				</treeview>
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SetProductsApprovedAction"
					name="action.catalog.setapproved" />
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SetProductsUnapprovedAction"
					name="action.catalog.setunapproved" />
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SetProductsCheckAction"
					name="action.catalog.setcheck" />
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SyncItemsSearchResultAction"
					name="action.catalog.syncproducts" />
				<action type="searchresult"
					classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard" />
                <action type="toolbar"
                    classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard"/>
			</result>
			<editor>
				<!-- <tab name="administration" id="tab_administration" />-->
				<tab name="tab.publications" mode="delete" />
				<tab name="tab.sync.settings" mode="delete" />
				<tab name="tab.categorysystem" mode="delete" />
				<tab name="tab.versions" mode="delete" />
				<tab name="product.descriptions"
					id="tab_product_descriptions" mode="delete" />
				<tab name="tab.catalog.classification" mode="delete" />
				<tab name="tab.product.features" mode="delete" />
				
				<tab name="product.prices" id="tab_europe1_prices"
					position="4" mode="delete" />
				<tab name="tab.product.properties" mode="delete" />
				<tab name="tab.variants" mode="delete"/>
				
				<tab name="tab.products" id="tab_product_common"
					mode="replace" position="1">
					<section name="section.product_allgemein">
						<listlayout>
						    <attribute name="aktiv" width="50"></attribute>
						    <attribute name="produkt_neu" width="50"></attribute>
						</listlayout>
					</section>
					<section name="section.product_categories">
						<listlayout>
							<attribute name="supercategories"
								labelwidth="100" width="600">

								<referencecollectioneditor resortable="false" add="true" remove="true" create="true" editable="false ">
									<preset sourceattribute="CategoryProductRelation" targetattribute="CategoryProductRelation" />
									<itemlayout>
										<attribute name="code" width="100" />
										<attribute name="name" width="200" />
										<attribute name="catalogVersion" width="200" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
					<section name="section.allgemein">
						<listlayout>
							<attribute name="description1" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
<!--							
							<attribute name="description2" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
-->							
							<!-- <attribute name="description2"
								labelwidth="100">
								<wysiwygeditor />
							</attribute> -->
<!--							
							<attribute name="description3"
								labelwidth="100" />
-->						
						</listlayout>
					</section>
				</tab>
				
            <tab name="tab.product.technicalattributes" position="2" mode="replace" >
					
               <section name="section.product.classifiedattributes">
                  <listlayout>
					 <customchip classname="com.computationaldesign.wera.hmc.ClassificationEditorChip" />
                  </listlayout>
                  <!--<listlayout>
                     <customchip classname="de.hybris.platform.catalog.hmc.ClassificationEditorChip"/>
                  </listlayout>-->
               </section>
               <section name="section.product.untypedfeatures">
                  <listlayout>
                     <text name="text.product.untypedfeatures"/>
                     <attribute name="untypedFeatures">
                        <referencecollectioneditor create="false">
                           <itemlayout>
                           	<attribute name="qualifier" width="120"/>
                           	<attribute name="unit" width="100"/>
                           	<attribute name="valueDetails" width="100"/>
                           	<attribute name="description" width="124"/>
                           </itemlayout>
                        </referencecollectioneditor>
                     </attribute>
                  </listlayout>
               </section>
            </tab>
				
				
				
				<tab name="tab.product.variants" mode="delete" />
				<tab name="tab.artikelkomplett" mode="replace" position="2">
<!--
					<section name="section.product.variants">
					   <listlayout>
						  <attribute name="variants" width="595">
							 <referencecollectioneditor typeattribute="varianttype" editable="true" externalcreate="false" add="false" create="true" resortable="false">
								<preset targetattribute="baseproduct"/>
								<preset sourceattribute="code" targetattribute="code"/>
							 </referencecollectioneditor>
						  </attribute>
					   </listlayout>
					 </section>
-->
					<section name="section.artikelkomplett">					
						<listlayout>
							<text name="text.variants"/>
							<attribute name="variantType"/>
							
<!--	
						  <attribute name="variants" width="595">
							 <referencecollectioneditor typeattribute="varianttype" editable="true" externalcreate="false" add="false" create="true" resortable="false">
								<preset targetattribute="baseproduct"/>
								<preset sourceattribute="code" targetattribute="code"/>
							 </referencecollectioneditor>
						  </attribute>
-->							
							<attribute name="variants" labelwidth="100"
								mode="replace">
								<customeditor classname="com.computationaldesign.wera.hmc.ClassificationVariantListEditorChip" />							
							</attribute>

						</listlayout>
					</section>

				</tab>
				<tab name="tab.outputcontrol" position="6">
					<section name="verwaltung">
						<listlayout>
							<attribute name="outputcontrols" maxlength="700" width="500">
							
								<referencecollectioneditor 
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true">
									<itemlayout>
										<attribute name="code" width="80" />
  							            <attribute name="order" width="50" />
  							            <attribute name="bezeichnung" width="300" />
  							            <attribute name="background" width="80" />
										<attribute name="showinset" width="80" />
										<attribute name="visibility" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							
							<attribute name="category2productexts"  width="500">
							
								<referencecollectioneditor 
									externalcreate="false" resortable="false" create="true"
									editable="true" remove="false" add="true" autoperform="true" >
									<itemlayout>
  							            <attribute name="category" width="300"/>
										<attribute name="catalogversion_desc" width="250" />
  							            <attribute name="priority" width="70"/>
  							            <attribute name="pagenr_catalog" width="70"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							
						    <attribute name="alternate_product" width="500" />
							
<!-- getilgt 29.07.2011 GT
						    <attribute name="order" width="50" />
							<attribute name="pagenr" width="50" />
-->							
							<attribute name="footnotes">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true"
									autoperform="true">
									<itemlayout>
										<attribute name="code" />
										<attribute name="name" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							
							<attribute name="keywords" labelwidth="100" width="350">
								<referencecollectioneditor resortable="false" add="true" remove="true" create="true">
									<preset sourceattribute="catalogVersion" targetattribute="catalogVersion" />
									<itemlayout>
										<attribute name="keyword" width="150" />
										<attribute name="catalogVersion" width="150" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>

						</listlayout>
					</section>
				</tab>
<!-- 				
				<tab name="tab.artikelkatalog" mode="replace" position="3">
					<section name="section.artikelkatalog">
						<listlayout>
							<attribute name="variants" labelwidth="100"
								mode="append">
								<customeditor
									classname="com.computationaldesign.wera.webmc.ClassificationVariantListEditorChip" />
							</attribute>

						</listlayout>
					</section>
				</tab>
				<tab name="tab.preisliste" mode="replace" position="4">
					<section name="section.preisliste">
					</section>
				</tab>
-->
				<tab name="multimedia" mode="replace" position="4">
					<section name="section.multimedia">
						<listlayout>
							<attribute name="icons1" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="icons2">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="pictures1">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="pictures2">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="pictures3">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="featureicons1">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="featureicons2">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>

						</listlayout>

					</section>
					
					
					
				</tab>

			</editor>
		</organizer>
	</type>
	
	<!-- Wera Produkt Satz -->
	<type name="WeraProductSet" mode="append" icon="/wera/images/e_werasatz_neu.gif">
		<organizer>
			<search mode="append">
				<condition attribute="catalogVersion" />
			</search>
			<result mode="append">
				<listview mode="replace">
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name" />
						<attribute name="catalogVersion" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview mode="replace" >
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name" />
						<attribute name="catalogVersion" />
					</itemlayout>
				</treeview>
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SetProductsApprovedAction"
					name="action.catalog.setapproved" />
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SetProductsUnapprovedAction"
					name="action.catalog.setunapproved" />
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SetProductsCheckAction"
					name="action.catalog.setcheck" />
				<action type="searchresult"
					classname="de.hybris.platform.hmc.ext.catalog.SyncItemsSearchResultAction"
					name="action.catalog.syncproducts" />
				<action type="searchresult"
					classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard" />
                <action type="toolbar"
                    classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard"/>
			</result>
			<editor>
				<!-- <tab name="administration" id="tab_administration" />
				<tab name="tab.publications" mode="delete" />-->
				<tab name="tab.sync.settings" mode="delete" />
				<tab name="tab.categorysystem" mode="delete" />
				<tab name="tab.versions" mode="delete" />
				<tab name="tab.bmecat" position="5" mode="replace">
					<section name="section.bmecat.product.ids">
						<columnlayout leftwidth="370" rightwidth="370">
							<row>
								<text name="text.bmecat"/>
							</row>
							<row>
								<attribute name="manufacturertypedescription" labelwidth="100" width="224"/>
								<attribute name="supplieralternativeaid" labelwidth="100" width="224"/>
							</row>
							<row>
								<attribute name="erpgroupbuyer" labelwidth="100" width="224"/>
								<attribute name="erpgroupsupplier" labelwidth="100" width="224"/>
							</row>
							<row>
								<attribute name="buyerids" labelwidth="100">
									<mapeditor keyname="buyerids.key" valuename="buyerids.value"/>
								</attribute>
							</row>
							<row>
								<attribute name="articleStatus" labelwidth="100">
									<mapeditor keyname="articlestatus.key" valuename="articlestatus.value"/>
								</attribute>
							</row>
							<row>
								<attribute name="specialtreatmentclasses" labelwidth="100">
									<mapeditor keyname="specialtreatmentclasses.key" valuename="specialtreatmentclasses.value"/>
								</attribute>
							</row>
						</columnlayout>
					</section>
					<section name="section.additional_properties">
						<columnlayout leftwidth="370" rightwidth="370">
							<row>
								<attribute name="segment" labelwidth="100" width="224"/>
							</row>
							<row>
								<attribute name="minorderquantity" labelwidth="100" width="224"/>
								<attribute name="orderquantityinterval" labelwidth="100" width="224"/>
							</row>
						</columnlayout>
					</section>
					<section name="section.bmecat.product.xml">
						<columnlayout leftwidth="370" rightwidth="370">
							<row>
								<text name="text.xml" width="480"/>
							</row>
							<row>
								<attribute name="xmlcontent" labelwidth="100">
									<textareaeditor expanded="true" wrap="false" rows="15"/>
								</attribute>
							</row>
							<row>
								<attribute name="startLineNumber" labelwidth="100" width="224"/>
								<attribute name="endLineNumber" labelwidth="100" width="224"/>
							</row>
						</columnlayout>
					</section>
				</tab>
				<tab name="product.descriptions"
					id="tab_product_descriptions" mode="delete" />
				<tab name="tab.catalog.classification" mode="delete" />
				<tab name="tab.product.features" mode="delete" />
            <tab name="product.prices" id="tab_europe1_prices" position="4" mode="append">
               <section name="product.pricesdiscounts">
                  <listlayout>
                     <attribute name="europe1Prices" labelwidth="100" width="560">
                        <referencecollectioneditor editable="true" externalcreate="false" resortable="false" presetattribute="product" remove="true" create="true">
                           <itemlayout>
<!--                               <attribute name="user" width="100"/> -->
                              <attribute name="ug" width="150"/>
                              <attribute name="pg" width="150"/>
                              <attribute name="unit" width="100"/>
                              <attribute name="minqtd" width="40"/>
                              <attribute name="price" width="70"/>
                              <attribute name="currency" width="100"/>
                           </itemlayout>
                        </referencecollectioneditor>
                     </attribute>
                     <attribute name="europe1Discounts" labelwidth="100" width="560">
                        <referencecollectioneditor editable="true" externalcreate="false" resortable="false" presetattribute="product" remove="true" create="true">
                           <itemeditorlayout>
<!--                               <attribute name="user" width="100"/> -->
                              <attribute name="ug" width="150"/>
                              <attribute name="pg" width="150"/>
                              <attribute name="discountstring" width="80"/>
                              <attribute name="discount" width="100"/>
                              <attribute name="daterange" width="260">
                                 <editor classname="de.hybris.platform.hmc.attribute.DateOnlyDateRangeEditorChip">
                                    <parameter key="wrapvalues" value="false"/>
                                    <parameter key="showpattern" value="false"/>
                                 </editor>
                              </attribute>
                           </itemeditorlayout>
                        </referencecollectioneditor>
                     </attribute>
                     <attribute name="Europe1PriceFactory_PTG" labelwidth="100" />
                  </listlayout>
               </section>
            </tab>
					
				<tab name="tab.product.properties" mode="delete" />
				<tab name="tab.products" id="tab_product_common"
					mode="replace" position="1">
					<section name="section.product_allgemein">
						<listlayout>
						    <attribute name="aktiv" width="50"></attribute>
						</listlayout>
					</section>
					<section name="section.product_categories">
						<listlayout>
                     <attribute name="supercategories"
                        labelwidth="100" width="600">

                        <referencecollectioneditor resortable="false" add="true" remove="true" create="true" editable="false ">
                           <preset sourceattribute="CategoryProductRelation" targetattribute="CategoryProductRelation" />
                           <itemlayout>
                              <attribute name="code" width="100" />
                              <attribute name="name" width="200" />
                              <attribute name="catalogVersion" width="200" />
                           </itemlayout>
                        </referencecollectioneditor>
                     </attribute>
						</listlayout>
					</section>
					<section name="section.product_attributs">
						<listlayout>
							<customchip
								classname="com.computationaldesign.wera.hmc.ClassificationEditorChip" />
						</listlayout>
					</section>
					<section name="section.allgemein">
						<listlayout>
  						    <attribute name="lagernr" width="40" />
							<attribute name="artnr" />
							<attribute name="variantenNr" width="50" />
							<attribute name="variantenNrEU" width="50" />
							<attribute name="variantenNrUS" width="50" />
							<attribute name="contentQuantity" />
							<attribute name="description1" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
<!-- Getilgt - 29.07.2011 GT	
							<attribute name="description2" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
-->
<!-- Getilgt - 29.07.2011 GT
							<attribute name="description3" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>							
-->							
						</listlayout>
					</section>
				</tab>
				<tab name="tab.variants" mode="delete" />
				<tab name="tab.artikelkomplett" mode="replace" position="2">
					<section name="section.artikelkomplett">
					   <listlayout>
						  <text name="text.variants"/>
						  <attribute name="variantType"/>
						  <attribute name="variants" width="595">
							 <referencecollectioneditor typeattribute="varianttype" editable="true" externalcreate="false" add="false" create="true" resortable="false">
								<preset targetattribute="baseproduct"/>
								<preset sourceattribute="code" targetattribute="code"/>
							 </referencecollectioneditor>
						  </attribute>
					   </listlayout>
					 </section>					
					
				</tab>
				<tab name="multimedia" mode="replace" position="4">
					<section name="section.multimedia">
						<listlayout>
							<attribute name="icons1" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="icons2">
								<referencecollectioneditor
