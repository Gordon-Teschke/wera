	<!-- Wera Media Satz -->
	<type name="WeraMedia" icon="images/icons/multimedia_container.gif"
		mode="append">
		<organizer>
			<search mode="replace">
				<condition attribute="code" operator="contains" />
				<condition attribute="mime" />
			</search>
			<result>
				<listview mode="replace">
					<itemlayout>
						<attribute name="url" title="title.image"
							width="50">
							<display
								classname="de.hybris.platform.hmc.attribute.UrlAsImageDisplayChip">
								<parameter key="height" value="30" />
							</display>
						</attribute>
						<attribute name="code" width="200" />
						<attribute name="mime" width="100" />
						<attribute name="url2" title="title.download"
							width="50">
							<display
								classname="de.hybris.platform.hmc.attribute.MediaDownloadUrlChip" />
						</attribute>
					</itemlayout>
				</listview>
				<editview mode="replace">
					<itemlayout>
						<attribute name="code" width="200" />
						<attribute name="mime" />
					</itemlayout>
				</editview>
				<treeview mode="replace">
					<itemlayout>
						<attribute name="code" />
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<exclude>
					<exclusion attribute="mime" />
					<exclusion attribute="realfilename" />
					<exclusion attribute="url2" />
				</exclude>
				<essentials>
					<listlayout>
						<attribute name="code" labelwidth="100" />
					</listlayout>
				</essentials>
				<tab name="properties" position="0">
					<section name="properties">
						<listlayout>
							<attribute name="url" labelwidth="100">
								<specialeditor
									classname="de.hybris.platform.hmc.media.MediaFileUploadEditorChip"
									parameter="showpreview" />
							</attribute>
							<attribute name="alttext" labelwidth="100" />
							<attribute name="downloadurl"
								labelwidth="100" />
<!--  							<attribute name="hybrisfilename" labelwidth="100" /> -->
							<attribute name="description"  >
                                <textareaeditor rows="10" />
							</attribute>
						</listlayout>
					</section>
				</tab>
				<!--
					<tab name="links" position="1">
					<section name="search">
					<table>
					<tr>
					<td>
					<shortcut name="findproductsforthumbnail" type="Product" usage="finder" autoperform="true">
					<preset targetattribute="thumbnail"/>
					</shortcut>
					</td>
					<td>
					<shortcut name="findproductsforpicture" type="Product" usage="finder" autoperform="true">
					<preset targetattribute="picture"/>
					</shortcut>
					</td>
					</tr>
					<tr>
					<td>
					<shortcut name="findcategorynodesforthumbnail" type="Category" usage="finder" autoperform="true">
					<preset targetattribute="thumbnail"/>
					</shortcut>
					</td>
					<td>
					<shortcut name="findcategorynodesforpicture" type="Category" usage="finder" autoperform="true">
					<preset targetattribute="picture"/>
					</shortcut>
					</td>
					</tr>
					</table>
					</section>
					</tab>
				-->
			</editor>
		</organizer>
		<defaultreference searchattribute="code" mode="replace">
			<itemlayout>
				<attribute name="code" />
			</itemlayout>
		</defaultreference>
	</type>


	<type name="ProductFeature" mode="append">
		<organizer>
			<editor>
				<tab name="tab.footnote" position="1">
					<section name="section.footnote">
						<listlayout>
							<attribute name="footnotes">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="true" remove="true" add="true" autoperform="true">
									<itemlayout>
										<attribute name="code"
											width="50" />
										<attribute name="name"
											width="200" />
										<attribute name="kennzeichner" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>

	<type name="ClassAttributeAssignment" mode="append">
		<organizer>
			<editor>
				<tab name="customValues" position="1">
					<section name="verwaltung">
						<listlayout>
							<attribute name="order" />
							<attribute name="aktiv" />
							<attribute name="background" />
						</listlayout>
					</section>
					<section name="customValues">
						<listlayout>
							<attribute name="customValues">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									remove="true" add="true" autoperform="true" editable="true">
									<preset
										sourceattribute="classificationSystemVersion"
										targetattribute="classificationSystemVersion" />
									<itemlayout>
										<attribute name="code"
											width="50" />
										<attribute name="name"
											width="200" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
					<section name="section.icons">
						<listlayout>
							<attribute name="icons">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>


	<type name="WeraVariante" mode="append">
		<organizer>
			<result>
				<editview mode="replace">
					<itemlayout>
						<attribute name="lagernr" width="40" />
						<attribute name="code" width="60" />
						<!-- attribute name="variantenNr" width="50" / -->
						<attribute name="order" width="40" />
						<!-- <attribute name="f1" width="50" /> -->
						<!-- <attribute name="priceInfo" width="50" />  -->
						<attribute name="ean" width="100" />
						<attribute name="contentQuantity" width="40" />
						<attribute name="aktiv" width="20" />
					</itemlayout>
				</editview>
			</result>
			<editor>
                  		
            <tab name="product.prices" id="tab_europe1_prices" position="1" mode="replace">
               <section name="product.pricesdiscounts">
                  <listlayout>
                     <attribute name="europe1Prices" labelwidth="100" width="560">
                        <referencecollectioneditor editable="true" externalcreate="false" resortable="false" presetattribute="product" remove="true" create="true">
                           <itemlayout>
<!--                               <attribute name="user" width="100"/> -->
                              <attribute name="pg" width="150"/>
                              <attribute name="ug" width="150"/>
                              <attribute name="unit" width="100"/>
                              <attribute name="minqtd" width="40"/>
                              <attribute name="price" width="70"/>
                              <attribute name="currency" width="100"/>
                           </itemlayout>
                        </referencecollectioneditor>
                     </attribute>
                     <attribute name="europe1Discounts" labelwidth="100" width="560">
                        <referencecollectioneditor editable="true" externalcreate="false" resortable="false" presetattribute="product" remove="true" create="true">
                           <itemeditorlayout>
<!--                               <attribute name="user" width="100"/> -->
                              <attribute name="pg" width="150"/>
                              <attribute name="ug" width="150"/>
                              <attribute name="discountstring" width="80"/>
                              <attribute name="discount" width="100"/>
                              <attribute name="daterange" width="260">
                                 <editor classname="de.hybris.platform.hmc.attribute.DateOnlyDateRangeEditorChip">
                                    <parameter key="wrapvalues" value="false"/>
                                    <parameter key="showpattern" value="false"/>
                                 </editor>
                              </attribute>
                           </itemeditorlayout>
                        </referencecollectioneditor>
                     </attribute>
                     <attribute name="Europe1PriceFactory_PTG" labelwidth="100" />
                  </listlayout>
               </section>
            </tab>
				<tab name="tab.product.properties" mode="replace" >
					<section name="section.catalog_and_validity" mode="delete" />
				</tab>
				
				<tab name="weravariante.functions" position="20" mode="append">
					<section name="section.catalog_and_validity">
						<columnlayout leftwidth="370" rightwidth="370">
							<row>
								<attribute name="catalogversion" labelwidth="100" width="224" />
								<attribute name="approvalStatus" labelwidth="100" width="224" />
							</row>
							<row>
								<attribute name="onlineDate" labelwidth="100" width="224">
									<dateeditor />
								</attribute>
								<attribute name="offlineDate" labelwidth="100" width="224">
									<dateeditor />
								</attribute>							</row>
							<row>
							<attribute name="aktiv"><booleaneditor /></attribute>
							</row>
						</columnlayout>
					</section>					
					<section name="section.footnote">
						<listlayout>
							<attribute name="footnotes">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="true" remove="true" add="true" autoperform="true">
									<itemlayout>
										<attribute name="code"
											width="50" />
										<attribute name="kennzeichner" />
										<attribute name="name"
											width="400" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
				</tab>

			</editor>
		</organizer>
	</type>
	
	<type name="Footnote" mode="append">
