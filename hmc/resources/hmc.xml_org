	<!-- Category -->
	<type name="Category" mode="append" icon="/wera/images/e_kapitel_neu.gif">
		<organizer>
			<result mode="replace" defaultview="tree">
				<listview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
					<explorable>
						<attribute name="categories"
							suppressroot="true" />
						<attribute name="products" suppressroot="true" />
					</explorable>
				</treeview>
			</result>
			<editor>

				<tab name="tab.properties" mode="delete" />
				<tab name="tab.wera.textpages" position="0">
					<section name="section.wera.textpages.infopage"
						mode="append">
						<listlayout>
							<attribute name="untertitel" width="500" />
							<attribute name="concat_description" width="500" />
							<attribute name="description" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
							<attribute name="keywords" labelwidth="100" width="350">
								<referencecollectioneditor resortable="false" add="true" remove="true" create="true">
									<preset sourceattribute="catalogVersion" targetattribute="catalogVersion" />
									<itemlayout>
										<attribute name="keyword" width="150" />
										<attribute name="catalogVersion" width="150" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
<!-- 
							<attribute name="textpages">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="true" remove="true" add="true" autoperform="true">
									<itemlayout>
										<attribute name="code"
											width="50" />
										<attribute name="name"
											width="400" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
-->								
						</listlayout>
						<listlayout>
							<attribute name="order" width="50" />
							<attribute name="aktiv" width="50" />
<!-- getilgt 29.07.2011 GT
							<attribute name="pagenr" width="50" />
-->
						</listlayout>
					</section>
					<section name="section.icons">
						<listlayout>
							<attribute name="icons">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
									</tab>
            <tab name="multimedia" position="2" mode="replace">
               <section name="pictures" mode="replace">
                  <listlayout>
                     <attribute name="picture" labelwidth="100">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
                     <attribute name="thumbnail" labelwidth="100">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
                  </listlayout>
               </section>
					<section name="section.additionalmedias" mode="replace">
						<listlayout>
							<attribute name="medias" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
							<attribute name="data_sheet" labelwidth="100"  >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
							<attribute name="detail" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
							<attribute name="logo" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
							<attribute name="normal" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
							<attribute name="others" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
							<attribute name="thumbnails" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
                     </attribute>
						</listlayout>
					</section>
            </tab>

			</editor>
		</organizer>
	</type>
	
	<!-- Textelement -->
	<type name="Textitem">
		<organizer>
			<search mode="replace">
				<condition attribute="code" />
				<condition attribute="name" />
			</search>
			<result mode="append">
				<listview>
					<itemlayout>
						<attribute name="code" width="100" />
						<attribute name="name" width="90" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<tab name="tab.wera.textitem" position="0">
					<section name="section.wera.textitem.alg">
						<listlayout>
							<attribute name="code" />
							<attribute name="name" />
							<attribute name="order" />
							<attribute name="header" />
						</listlayout>
					</section>
					<section name="section.wera.textitem.text">
						<listlayout>
							<attribute name="textblock" >
								<textareaeditor rows="30" />
							</attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>

	
	<!-- Abtrieb -->
	<type name="Tips">
		<organizer>
			<search mode="replace">
				<condition attribute="code" />
				<condition attribute="name" />
			</search>
			<result mode="append">
				<listview>
					<itemlayout>
						<attribute name="code" width="100" />
						<attribute name="name" width="90" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
				</treeview>
			</result>
			<editor mode="append">
				<tab name="tab.wera.tip" position="0">
					<section name="section.wera.tip.alg">
						<listlayout>
							<attribute name="code" />
							<attribute name="name" />
						</listlayout>
					</section>
					<section name="section.wera.tip.text">
						<listlayout>
							<attribute name="order" />
							<attribute name="aktiv" />
							<attribute name="icon">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>
	
	<!-- Ausgabesteuerung -->
	<type name="Outputcontrol">
		<organizer>
			<search mode="replace">
				<condition attribute="code" />
				<condition attribute="name" />
			</search>
			<result mode="append">
				<listview>
					<itemlayout>
						<attribute name="code" width="100" />
						<attribute name="name" width="90" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<tab name="common" position="0">
					<section name="verwaltung">
						<listlayout>
							<attribute name="code" />
							<attribute name="order" />
							<attribute name="bezeichnung" width="300" />
							<attribute name="visibility" width="170" />
							<attribute name="aktiv" />
							<attribute name="background" />
							<attribute name="showinset" />
						</listlayout>
					</section>

					<section name="section.icons">
						<listlayout>
							<attribute name="icons">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>

				</tab>
			</editor>
		</organizer>
	</type>

   <type name="PriceRow" icon="images/icons/e_pricerow.gif" mode="append">
      <organizer>
         <search mode="replace">
            <condition attribute="product" operator="equal"/>
            <condition attribute="pg" operator="equal"/>
            <condition attribute="user" operator="equal"/>
            <condition attribute="ug" operator="equal"/>
         </search>
         <result>
            <listview mode="replace">
               <itemlayout>
                  <attribute name="product" width="320"/>
                  <attribute name="ug" width="220"/>
                  <attribute name="price" width="70"/>
                  <attribute name="currency" width="70"/>
                  <attribute name="order" width="15"/>
               </itemlayout>
            </listview>
            <editview mode="replace">
               <itemlayout>
                  <attribute name="product" width="160"/>
                  <attribute name="pg" width="120"/>
                  <attribute name="user" width="120"/>
                  <attribute name="ug" width="120"/>
                  <attribute name="price"/>
               </itemlayout>
            </editview>
            <treeview mode="replace">
               <itemlayout>
                  <attribute name="product"/>
                  <attribute name="pg"/>
                  <attribute name="user"/>
                  <attribute name="ug"/>
               </itemlayout>
            </treeview>
         </result>
         <editor>
            <tab name="properties" position="0" mode="append">
               <section name="properties">
                  <listlayout>
                        <attribute name="order" labelwidth="100" width="100"/>
                        <attribute name="evk" />
                        <attribute name="aufanfrage" />
                  </listlayout>
               </section>
            </tab>
         </editor>
      </organizer>
      <defaultreference>
         <itemlayout mode="replace">
            <attribute name="product"/>
            <attribute name="pg"/>
            <attribute name="user"/>
            <attribute name="ug"/>
         </itemlayout>
      </defaultreference>
   </type>


</configuration>
