						<listlayout>
							<attribute name="weravariantevariants_qual" labelwidth="100"
								mode="replace">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="true" remove="true" add="true" prohibitopening="false"
									autoperform="true">
									<itemlayout>
										<attribute name="weravariants" width="400" />
										<attribute name="order" />
										<attribute name="vpe" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="weraproductsetvariants_qual" labelwidth="100" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="true" remove="true" add="true" prohibitopening="false"
									autoperform="true">
									<itemlayout>
										<attribute name="weraproductsets" width="400" />
										<attribute name="order" />
										<attribute name="vpe" />
									</itemlayout>
