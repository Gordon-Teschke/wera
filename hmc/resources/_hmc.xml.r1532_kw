	<type name="PriceRow" icon="images/icons/e_pricerow.gif" mode="append">
		<organizer>
			<search mode="replace">
				<condition attribute="product" operator="equal"/>
				<condition attribute="pg" operator="equal"/>
				<condition attribute="user" operator="equal"/>
				<condition attribute="ug" operator="equal"/>
			</search>
			<result>
				<listview mode="replace">
					<itemlayout>
						<attribute name="product" width="320"/>
						<attribute name="ug" width="220"/>
						<attribute name="price" width="70"/>
						<attribute name="currency" width="70"/>
						<attribute name="order" width="15"/>
					</itemlayout>
				</listview>
				<editview mode="replace">
					<itemlayout>
						<attribute name="product" width="160"/>
						<attribute name="pg" width="120"/>
						<attribute name="user" width="120"/>
						<attribute name="ug" width="120"/>
						<attribute name="price"/>
					</itemlayout>
				</editview>
				<treeview mode="replace">
					<itemlayout>
						<attribute name="product"/>
						<attribute name="pg"/>
						<attribute name="user"/>
						<attribute name="ug"/>
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<tab name="properties" position="0" mode="append">
					<section name="properties">
						<listlayout>
							<attribute name="order" labelwidth="100" width="100"/>
							<attribute name="evk" />
							<attribute name="aufanfrage" />
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
		<defaultreference>
			<itemlayout mode="replace">
				<attribute name="product"/>
				<attribute name="pg"/>
				<attribute name="user"/>
				<attribute name="ug"/>
			</itemlayout>
		</defaultreference>
	</type>

	<type name="CatalogVersion" mode="append">
		<organizer>
			<editor>
				<tab name="tab.catalog" mode="append" >
					<section name="section.catalog" mode="append" >
						<columnlayout>
							<row>
								<attribute name="is_webcatalog">
									<advancedbooleaneditor truename="true" falsename="false"/>
								</attribute>
							</row>
							<row>
								<attribute name="archiviert"></attribute>
								<attribute name="domain">
									<advancedbooleaneditor truename="true" falsename="false"/>
								</attribute>
							</row>
						</columnlayout>
						<listlayout>
							<attribute name="upg4csv"></attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>

</configuration>
