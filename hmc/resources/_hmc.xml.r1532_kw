				</tab>
			</editor>
		</organizer>
	</type>


	<type name="WeraVariante" mode="append">
		<organizer>
			<result>
				<editview mode="replace">
					<itemlayout>
						<attribute name="lagerNr" width="60" />
						<attribute name="code" width="60"  />
						<attribute name="variantenNr" width="60"  />
						<attribute name="variantenNrEU" width="60"  />
						<attribute name="variantenNrUS" width="60"  />
						<attribute name="aktiv" width="40"  />
						<attribute name="is_marketing_representative" width="40"  />
						<attribute name="is_bulletpoint_representative" width="40"  />
						<attribute name="order" width="40"  />
						<attribute name="contentQuantity" width="40"  />
					</itemlayout>
				</editview>
			</result>
			<editor>

				<!-- Tabs entfernen -->
				<tab name="tab.versions" mode="delete" />

			
				<!-- Stammdaten -->
				<tab name="tab.product.properties" mode="replace" position="1" >
					<section name="section.catalog_and_validity" mode="delete" />
					<section name="section.allgemein" >
						<listlayout>
							<attribute name="contentQuantity" width="40" labelwidth="100" />
							<attribute name="artikel_neu" width="60" labelwidth="100" />
							<attribute name="artikel_auslauf" width="60" labelwidth="100" />
							<attribute name="aktiv" width="40" labelwidth="100" />
							<!--							<attribute name="ausgabe_preisliste" width="60" labelwidth="100" /> -->
							<attribute name="lagerNr" width="60" labelwidth="100" />
							<attribute name="variantenNr" width="60" labelwidth="100" />
							<attribute name="variantenNrUS" width="60" labelwidth="100" />
							<attribute name="variantenNrEU" width="60" labelwidth="100" />
							<attribute name="ZolltarifNr" width="100" labelwidth="100" />
							<attribute name="Ursprungsland" width="60" labelwidth="100" />
							<!-- attribute name="Gewicht" width="60" labelwidth="100" / -->
