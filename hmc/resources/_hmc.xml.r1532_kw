			<result mode="append">
				<listview>
					<itemlayout>
						<attribute name="code" width="200" />
						<attribute name="title" width="200"  />
						<attribute name="preview" title="title.image" width="50">
							<display classname="com.computationaldesign.wera.hmc.DAMUrlAsImageDisplayChip" >
								<parameter key="height" value="30" />
								<parameter key="previewtype" value="xs" />
							</display>
						</attribute>
						<attribute name="location" width="300" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="title" />
						<attribute name="preview" title="title.image" width="50">
							<display classname="com.computationaldesign.wera.hmc.DAMUrlAsImageDisplayChip" >
								<parameter key="height" value="30" />
								<parameter key="previewtype" value="xs" />
							</display>
						</attribute>
						<attribute name="location" />
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<tab name="tab.wera.extimage" position="0">
					<section name="section.wera.extimage.alg">
						<listlayout>
							<attribute name="code" />
						</listlayout>
					</section>
					<section name="section.wera.extimage.links">
						<listlayout>
							<attribute name="show_image" width="500" />
							<attribute name="title" width="500" />
							<attribute name="location" width="500" />
							<attribute name="preview"  width="500" >
								<customeditor classname="com.computationaldesign.wera.hmc.ShowPreviewChip" >
									<parameter key="previewtype" value="md" />
								</customeditor>
							</attribute>
							<attribute name="description" width="500">
								<textareaeditor rows="10"  expanded="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>		
	
