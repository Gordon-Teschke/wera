							</row>
							<row>
								<attribute name="etikett_image"/>
								<attribute name="preview_etikett_image" width="30">
									<customeditor classname="com.computationaldesign.wera.hmc.ShowPreviewChip">
										<parameter key="previewtype" value="xs" />
									</customeditor>
								</attribute>
							</row>
						</columnlayout>
					</section>
				</tab>				
				
				<tab name="tab.artikelkomplett" mode="replace" >
					<section name="section.artikelkomplett">
