				</tab>
                                
                                
			</editor>
		</organizer>
	</type>
	<!-- Wera Produkt Satz in Satz +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
	<!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++Wera Produkt Satz in Satz -->

	
	
	<!-- Wera Media Satz -->
	<type name="WeraMedia" icon="images/icons/multimedia_container.gif"
		  mode="append">
		<organizer>
			<search mode="replace">
				<condition attribute="code" operator="contains" />
				<condition attribute="mime" />
			</search>
			<result>
				<listview mode="replace">
					<itemlayout>
						<attribute name="url" title="title.image"
								   width="50">
							<display classname="de.hybris.platform.hmc.attribute.UrlAsImageDisplayChip" >
								<parameter key="height" value="30" />
							</display>
						</attribute>
						<attribute name="code" width="200" />
						<attribute name="mime" width="100" />
						<attribute name="url2" title="title.download"
								   width="50">
							<display
								classname="de.hybris.platform.hmc.attribute.MediaDownloadUrlChip" />
						</attribute>
					</itemlayout>
				</listview>
				<editview mode="replace">
					<itemlayout>
						<attribute name="code" width="200" />
						<attribute name="mime" />
					</itemlayout>
				</editview>
				<treeview mode="replace">
					<itemlayout>
						<attribute name="code" />
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<exclude>
					<exclusion attribute="mime" />
					<exclusion attribute="realfilename" />
					<exclusion attribute="url2" />
				</exclude>
				<essentials>
					<listlayout>
						<attribute name="code" labelwidth="100" />
					</listlayout>
				</essentials>
				<tab name="properties" position="0">
					<section name="properties">
						<listlayout>
							<attribute name="url" labelwidth="100">
								<specialeditor
									classname="de.hybris.platform.hmc.MediaFileUploadEditorChip"
									parameter="showpreview" />
							</attribute>
							<attribute name="alttext" labelwidth="200" />
							<attribute name="rahmenbreite_in_percent" labelwidth="200" />
							<attribute name="downloadurl"
									   labelwidth="100" />
							<!--  							<attribute name="hybrisfilename" labelwidth="100" /> -->
							<attribute name="description"  >
								<textareaeditor rows="10" />
							</attribute>
						</listlayout>
					</section>
				</tab>
				<tab name="tab.media.metadata">
					<section name="section.media.metadata">
						<listlayout>
							<attribute name="alttext"/>
							<attribute name="downloadurl"/>
							<attribute name="feature_description" width="500">
								<textareaeditor rows="4" expanded="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
		<defaultreference searchattribute="code" mode="replace">
			<itemlayout>
				<attribute name="code" />
			</itemlayout>
		</defaultreference>
	</type>


