					</section>
					<section name="section.abmessungen_und_gewichte">
						<columnlayout leftwidth="300" rightwidth="300" width="600">
							<row>
								<attribute name="artikel_laenge" 	labelwidth="150" width="100" />
								<attribute name="packm_laenge" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_hoehe" 	labelwidth="150" width="100" />
								<attribute name="packm_hoehe" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_breite" 	labelwidth="150" width="100" />
								<attribute name="packm_breite" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_volumen" 	labelwidth="150" width="100" />
								<attribute name="packm_volumen" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_laengen_einheit" 	labelwidth="150" width="100" />
								<attribute name="packm_laengen_einheit" 	labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="Gewicht" 	labelwidth="150" width="100" />
								<attribute name="GewVE" 	labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="GewichtBrutto" 	labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="GewichtEinheit" 	labelwidth="150" width="100" />
								<attribute name="packm_gewichteh" 	labelwidth="150" width="100" />
							</row>
						</columnlayout>
					</section>
				</tab>
			
			
				<!-- Gueltigkeit -->
				<tab name="weravariante.functions" position="3" mode="append">
					<section name="section.catalog_and_validity">
						<columnlayout leftwidth="370" rightwidth="370">
							<row>
								<attribute name="catalogversion" labelwidth="100" width="224" />
								<attribute name="approvalStatus" labelwidth="100" width="224" />
							</row>
							<row>
								<attribute name="onlineDate" labelwidth="100" width="224">
									<dateeditor />
								</attribute>
								<attribute name="offlineDate" labelwidth="100" width="224">
									<dateeditor />
								</attribute>							
							</row>
							<row>
								<attribute name="aktiv">
									<booleaneditor />
								</attribute>
							</row>
						</columnlayout>
					</section>					
				</tab>

				
				<!-- Multimedia -->
