<configuration xmlns="hybris.de/schemas/hmc/generic"
			   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="hybris.de/schemas/hmc/generic hmc.xsd">
	<explorertree>
		<group name="catalog" expand="false" description="group.catalog.description">
			<typeref type="Textitem" position="6" description="typeref.Textitem.description" />
			<typeref type="Tips" position="7" description="typeref.Tips.description" />
			<typeref type="WeblinkText" position="8" description="typeref.WeblinkText.description" />
			<typeref type="Weblink" position="9" description="typeref.Weblink.description" />
			<typeref type="ExtImage" position="10" description="typeref.ExtImage.description" />
			<typeref type="Textbaustein" position="11" description="typeref.Textbaustein.description" />
			<typeref type="Bildreferenz" position="12" description="typeref.Bildreferenz.description" />
			<typeref type="Tipp" position="13" description="typeref.Tipp.description" />
		</group>
	</explorertree>

	<type name="SampleWizard" useselector="true">
		<organizer>
			<editor>
				<exclude>
					<exclusion attribute="owner"/>
				</exclude>
				<tab name="SampleWizard.tab1" position="0">
					<section name="SampleWizard.section1">
						<listlayout>
							<attribute name="productNeu" labelwidth="150" width="50" />
							<attribute name="productList" labelwidth="150" width="250" />
							<attribute name="categoryList" labelwidth="150" width="250" />
							<!--
												 <attribute name="seconds" labelwidth="100" />
												 <attribute name="pk" labelwidth="100" />
												 <attribute name="stringList" labelwidth="100" />
												   <attribute name="unitList" labelwidth="100" /> 
							-->
						</listlayout>
					</section>
				</tab>
				<!--             
							<tab name="SampleWizard.tab2" position="1">
							   <section name="SampleWizard.section2">
								  <listlayout>
									 <attribute name="artikelList" labelwidth="200" />
								  </listlayout>
							   </section>
							</tab>
				-->
			</editor>
		</organizer>
	</type>
	<type name="NexMartExportWizard" useselector="true">
		<organizer>
			<editor>
				<exclude>
					<exclusion attribute="owner"/>
				</exclude>
				<tab name="NexMartExportWizard.tab1" position="0">
					<section name="NexMartExportWizard.section1">
						<listlayout>
							<attribute name="classificationsystemversionlist" labelwidth="200" />
							<attribute name="export_categories" labelwidth="200" />
							<attribute name="export_products" labelwidth="200" />
						</listlayout>
					</section>
				</tab>
			</editor>
		</organizer>
	</type>


	<!-- Wera Produkt +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
	<!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++Wera Produkt  -->
	<type name="WeraProduct" mode="append" icon="/wera/images/e_weraprodukt_neu.gif">
		<organizer>
			<search mode="append">
				<condition attribute="catalogVersion" />
			</search>
			<result mode="append">
				<listview mode="replace">
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name"  width="400"/>
						<attribute name="catalogVersion"  width="120"/>
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview mode="replace" >
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name"  width="400"/>
						<attribute name="catalogVersion"  width="120"/>
					</itemlayout>
				</treeview>
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SetProductsApprovedAction"
						name="action.catalog.setapproved" />
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SetProductsUnapprovedAction"
						name="action.catalog.setunapproved" />
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SetProductsCheckAction"
						name="action.catalog.setcheck" />
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SyncItemsSearchResultAction"
						name="action.catalog.syncproducts" />
				<action type="searchresult"
						classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard" />
				<action type="toolbar"
						classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard"/>
			</result>
			<editor>
				<essentials mode="append" >
					<columnlayout>
						<row>
							<attribute name="desc_picture1"  /><!-- Name des Produktbilds -->
							<attribute name="check_artikelnr_index" width="420" /><!-- Alphanummerische Artikelnummer (mehrsprech. Print) -->
						</row>
					</columnlayout>
				</essentials>

				<!-- Tabs entfernen -->
				<tab name="tab.publications" mode="delete" />
				<tab name="tab.sync.settings" mode="delete" />
				<tab name="tab.categorysystem" mode="delete" />
				<tab name="tab.versions" mode="delete" />
				<tab name="product.descriptions" id="tab_product_descriptions" mode="delete" />
				<tab name="tab.catalog.classification" mode="delete" />
				<tab name="tab.product.features" mode="delete" />
				<tab name="product.prices" id="tab_europe1_prices" position="4" mode="delete" />
				<tab name="tab.product.properties" mode="delete" />
				<tab name="tab.variants" mode="delete"/>
				<tab name="tab.product.versions" mode="delete" />
				<tab name="tab.product.extendedattributes" mode="delete" />

				<!-- Stammdaten -->
				<tab name="tab.products" id="tab_product_common" mode="replace" position="1">
					<section name="section.product_allgemein">
						<listlayout>
							<!--						    <attribute name="aktiv" width="50"></attribute> -->
							<attribute name="produkt_neu" width="50"></attribute>
							<attribute name="artikel_sb_faehig" width="50"></attribute>
							<attribute name="artikel_auslauf" width="50"></attribute>
						</listlayout>
					</section>
					<section name="section.product.description">
						<listlayout>
							<attribute name="description1" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>

							<attribute name="description2" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
							
							<attribute name="description3" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
				
				<!-- Multimedia -->
				<tab name="tab.product.multimedia" mode="delete" />
				<tab name="multimedia" mode="replace" position="2">
					<section name="section.multimedia">
						<listlayout>
							<attribute name="icons1" >
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="icons2">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="pictures1">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="pictures2">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="pictures3">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="featureicons1">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="featureicons2">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="others_productpictures">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="secondaryimagesref2weraproduct">
								<referencecollectioneditor autoperform="true" create="true" remove="true" resortable="true">
									<itemlayout>
										<attribute name="code" width="400"/>
										<attribute name="preview" title="title.image" width="50">
											<display classname="com.computationaldesign.wera.hmc.DAMUrlAsImageDisplayChip" >
												<parameter key="height" value="30" />
												<parameter key="previewtype" value="xs" />
											</display>
										</attribute>
										<attribute name="location" width="400"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>							
														
						</listlayout>
					</section>
					<section name="section.product.usage_secondary_images">
						<listlayout>
							<attribute name="use_in_pricelist"></attribute>
							<attribute name="use_in_catalog"></attribute>
						</listlayout>
					</section>
					<section name="section.product.additionalmedias">
						<listlayout>
							<attribute name="data_sheet">
								<referencecollectioneditor autoperform="true" create="true">
									<preset targetattribute="catalogversion" sourceattribute="catalogversion"/>
									<itemlayout>
										<attribute name="code" width="270"/>
										<attribute name="catalogversion" width="271"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="detail">
								<referencecollectioneditor autoperform="true" create="true">
									<preset targetattribute="catalogversion" sourceattribute="catalogversion"/>
									<itemlayout>
										<attribute name="code" width="270"/>
										<attribute name="catalogversion" width="271"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="logo">
								<referencecollectioneditor autoperform="true" create="true">
									<preset targetattribute="catalogversion" sourceattribute="catalogversion"/>
									<itemlayout>
										<attribute name="code" width="270"/>
										<attribute name="catalogversion" width="271"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="normal">
								<referencecollectioneditor autoperform="true" create="true">
									<preset targetattribute="catalogversion" sourceattribute="catalogversion"/>
									<itemlayout>
										<attribute name="code" width="270"/>
										<attribute name="catalogversion" width="271"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="others">
								<referencecollectioneditor autoperform="true" create="true">
									<preset targetattribute="catalogversion" sourceattribute="catalogversion"/>
									<itemlayout>
										<attribute name="code" width="270"/>
										<attribute name="catalogversion" width="271"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="thumbnails">
								<referencecollectioneditor autoperform="true" create="true">
									<preset targetattribute="catalogversion" sourceattribute="catalogversion"/>
									<itemlayout>
										<attribute name="code" width="270"/>
										<attribute name="catalogversion" width="271"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
					<section name="section.product.externalmedia">
						<listlayout>
							
							<!-- neue struktur bildreferenz ersetzen extimages (extimages) -->
							<attribute name="anwenderimageref2weraproduct">
								<referencecollectioneditor autoperform="true" create="true" remove="true" resortable="true">
									<itemlayout>
										<attribute name="code" width="400"/>
										<attribute name="preview" title="title.image" width="50">
											<display classname="com.computationaldesign.wera.hmc.DAMUrlAsImageDisplayChip" >
												<parameter key="height" value="30" />
												<parameter key="previewtype" value="xs" />
											</display>
										</attribute>
										<attribute name="location" width="400"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<!-- neue struktur bildreferenz ersetzen extimages (extimages) -->
							
							<!-- extimages entfallen später -->
							<attribute name="extimages">
						 
								<referencecollectioneditor autoperform="true" create="true" remove="true" resortable="true">
									<itemlayout>
										<attribute name="code" width="150"/>
										<attribute name="title" width="200"/>
										<attribute name="preview" title="title.image" width="50">
											<display classname="com.computationaldesign.wera.hmc.DAMUrlAsImageDisplayChip" >
												<parameter key="height" value="30" />
												<parameter key="previewtype" value="xs" />
											</display>
										</attribute>
										<attribute name="location" width="300"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<!-- extimages entfallen später -->
							
						</listlayout>
					</section>
					
					<section name="section.product.tipps" mode="replace">
						<listlayout>
							<attribute name="sortimenttippref" labelwidth="100" width="300">
								<referencecollectioneditor externalcreate="false" resortable="true" create="true" editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
					
				</tab>
			
			
			
				<tab name="tab.product.categorysystem" position="3" mode="append">
					<section name="section.product.productreferences" mode="delete" />
				</tab>
				
				<!-- Merkmale -->
				<tab name="tab.product.technicalattributes" position="4" mode="replace" >
					
					<section name="section.product.classifiedattributes">
						<listlayout>
							<customchip classname="com.computationaldesign.wera.hmc.ClassificationEditorChip" />
						</listlayout>
						<!--<listlayout>
						   <customchip classname="de.hybris.platform.catalog.hmc.ClassificationEditorChip"/>
						</listlayout>-->
					</section>
					<section name="section.product.untypedfeatures">
						<listlayout>
							<text name="text.product.untypedfeatures"/>
							<attribute name="untypedFeatures">
								<referencecollectioneditor create="false">
									<itemlayout>
										<attribute name="qualifier" width="120"/>
										<attribute name="unit" width="100"/>
										<attribute name="valueDetails" width="100"/>
										<attribute name="description" width="124"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
				</tab>
				
				
				<!-- Ausagbesteuerung -->
				<tab name="tab.outputcontrol" position="5">
					<section name="verwaltung">
						<listlayout>
							<attribute name="outputcontrols" maxlength="700" width="500">

								<referencecollectioneditor 
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true">
									<itemlayout>
										<attribute name="code" width="80" />
										<attribute name="order" width="50" />
										<attribute name="bezeichnung" width="300" />
										<attribute name="background" width="80" />
										<attribute name="showinset" width="80" />
										<attribute name="visibility" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="category2productexts"  width="500">

								<referencecollectioneditor 
									externalcreate="false" resortable="false" create="true"
									editable="true" remove="false" add="true" autoperform="true" >
									<itemlayout>
										<attribute name="category" width="300"/>
										<attribute name="catalogversion_desc" width="250" />
										<attribute name="priority" width="70"/>
										<attribute name="pagenr_catalog" width="70"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="alternate_product" width="500" />
							<!-- getilgt 29.07.2011 GT
							<attribute name="order" width="50" />
							<attribute name="pagenr" width="50" />
							-->							
							<attribute name="outputtemplate" width="300" />
							<attribute name="priorityWebSearch" width="300" />

						</listlayout>
					</section>
					
					<section name="section.product.sbprogramm">
						<listlayout>
							<attribute name="weraproductsetinsets_relation" ><!-- SB-Varianten  -->
								<referencecollectioneditor editable="true" externalcreate="false" resortable="false" add="true" remove="true" create="true" showsearcheditor="true">
									<itemlayout>
										<attribute name="code" width="100" />
										<attribute name="name" width="600" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
                                   
					<section name="section.product.keywords">
						<listlayout>
							<text name="text.product.keywords" width="720"/>
							<attribute name="keywords">
								<referencecollectioneditor editable="true" externalcreate="false" resortable="false" add="true" remove="true" create="true" showsearcheditor="true">
									<preset sourceattribute="code" targetattribute="keyword"/>
									<preset sourceattribute="catalogVersion" targetattribute="catalogVersion"/>
									<itemlayout>
										<attribute name="keyword" width="200"/>
										<attribute name="language" width="85"/>
										<attribute name="catalogVersion" width="252"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="footnotes">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true"
									autoperform="true">
									<itemlayout>
										<attribute name="code" width="100" />
										<attribute name="name" width="600" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
				   
					<section name="section.product.greattools">
						<listlayout>
							<text name="text.weraproduct.greattools_textbaustein" width="720"/>
							<attribute name="use_for_greatttools"></attribute>
							<attribute name="great_tools_basename" width="600"></attribute>
						</listlayout>
					</section>				   
				   
				</tab>

				
				<!-- Artikelkomplett -->
				<tab name="tab.product.variants" mode="delete" />
				<tab name="tab.artikelkomplett" mode="replace" position="6">
					<!--
															<section name="section.product.variants">
															   <listlayout>
																	  <attribute name="variants" width="595">
																			 <referencecollectioneditor typeattribute="varianttype" editable="true" externalcreate="false" add="false" create="true" resortable="false">
																					<preset targetattribute="baseproduct"/>
																					<preset sourceattribute="code" targetattribute="code"/>
																			 </referencecollectioneditor>
																	  </attribute>
															   </listlayout>
															 </section>
					-->
					<section name="section.artikelkomplett">					
						<listlayout>
							<text name="text.variants"/>
							<attribute name="variantType"/>
							<!--	
																			  <attribute name="variants" width="595">
																					 <referencecollectioneditor typeattribute="varianttype" editable="true" externalcreate="false" add="false" create="true" resortable="false">
																							<preset targetattribute="baseproduct"/>
																							<preset sourceattribute="code" targetattribute="code"/>
																					 </referencecollectioneditor>
																			  </attribute>
																					<attribute name="variants" labelwidth="100" mode="replace">
																							<customeditor classname="com.computationaldesign.wera.hmc.ClassificationVariantListEditorChip" />							
																					</attribute>
							-->							
							<attribute name="variants" labelwidth="100" mode="replace">
								<customeditor classname="com.computationaldesign.wera.hmc.ArtikelClassificationVariantListEditorChip" />							
							</attribute>

						</listlayout>
					</section>

				</tab>

				
				<!-- Crosslinking / Weblinks -->
				<tab name="tab.product.outlinks" position="7" mode="replace">
					<section name="section.product.productreferences">
						<listlayout>
							<attribute name="productreferences">
								<referencecollectioneditor presetattribute="source" autoperform="true" externalcreate="false" editable="true" resortable="true" add="true" remove="true" create="true">
									<itemlayout>
										<!--<attribute name="sequence" width="50"/>-->
										<attribute name="referenceType" width="140"/>
										<attribute name="description" width="140"/>
										<attribute name="preselected" width="80"/>
										<attribute name="active" width="40"/>
										<attribute name="target" width="143"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
						</listlayout>
					</section>
				
					<section name="section.product.outlinks">
						<listlayout>
							<attribute name="weblinks">
								<referencecollectioneditor presetattribute="source" autoperform="true" externalcreate="false" editable="false" resortable="true" add="true" remove="true" create="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>

				<!-- Erweiterte Eigenschaften -->
				<tab name="tab.product.extendedattributes" mode="delete" />
				<tab name="tab.product.extendedattributes" position="8">
					<section name="section.product.print">
						<columnlayout>
							<row>
								<attribute name="artikelnr_index"/>
							</row>
						</columnlayout>
					</section>
					<section name="section.product.ids">
						<columnlayout>
							<row>
								<attribute name="ean"/>
								<attribute name="manufactureraid"/>
							</row>
							<row>
								<attribute name="manufacturername"/>
								<attribute name="deliverytime"/>
							</row>
							<row>
								<attribute name="contentunit"/>
								<attribute name="numbercontentunits"/>
							</row>
						</columnlayout>
					</section>
					<section name="section.product.remarks">
						<listlayout>
							<attribute name="remarks">
								<textareaeditor expanded="true" rows="5"/>
							</attribute>
						</listlayout>
					</section>
				</tab>
				
				<!-- Preise -->
				<tab name="tab.product.prices" position="13" mode="replace" >
					<section name="product.pricesdiscounts">
						<listlayout>
							<attribute name="europe1Prices" labelwidth="100" width="560">
								<referencecollectioneditor editable="true" externalcreate="false" resortable="false" presetattribute="product" remove="true" create="true">
									<itemlayout>
										<!--                               <attribute name="user" width="100"/> -->
										<attribute name="ug" width="150"/>
										<attribute name="pg" width="150"/>
										<attribute name="unit" width="100"/>
										<attribute name="minqtd" width="40"/>
										<attribute name="price" width="70"/>
										<attribute name="currency" width="100"/>
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="europe1Discounts" labelwidth="100" width="560">
								<referencecollectioneditor editable="true" externalcreate="false" resortable="false" presetattribute="product" remove="true" create="true">
									<itemeditorlayout>
										<!--                               <attribute name="user" width="100"/> -->
										<attribute name="ug" width="150"/>
										<attribute name="pg" width="150"/>
										<attribute name="discountstring" width="80"/>
										<attribute name="discount" width="100"/>
										<attribute name="daterange" width="260">
											<editor classname="de.hybris.platform.hmc.attribute.DateOnlyDateRangeEditorChip">
												<parameter key="wrapvalues" value="false"/>
												<parameter key="showpattern" value="false"/>
											</editor>
										</attribute>
									</itemeditorlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="Europe1PriceFactory_PTG" labelwidth="100" />
						</listlayout>
					</section>
				</tab>

				<!-- Onlineshops -->
                <tab name="tab.product.onlineshops" position="14" mode="replace">
					<section name="section.product.onlineshops.generell">
                        <listlayout>
							<!-- neu 09.12.2016 -->
							<attribute name="weraproductset2bulletpoints" width="800">
