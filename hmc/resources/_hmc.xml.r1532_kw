	<!-- Weblink -->
	<type name="Weblink">
		<organizer>
			<search mode="replace">
				<condition attribute="code" />
			</search>
			<result mode="append">
				<listview>
					<itemlayout>
						<attribute name="code" width="200" />
						<attribute name="weblinktext2weblink.code" width="200"  />
						<attribute name="link_wera_de" width="400" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="weblinktext2weblink.code" />
						<attribute name="link_wera_de" />
					</itemlayout>
				</treeview>
			</result>
			<editor>
				<tab name="tab.wera.weblink" position="0">
