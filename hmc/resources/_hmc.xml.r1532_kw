	<!-- Wera Produkt +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
	<!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++Wera Produkt  -->
	
	
	
	
	
	
	
	
	
	<!-- Wera Produkt Satz +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
	<!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++Wera Produkt Satz -->
	<type name="WeraProductSet" mode="append" icon="/wera/images/e_werasatz_neu.gif">
		<organizer>
			<search mode="append">
				<condition attribute="catalogVersion" />
				<condition attribute="artnr" />
			</search>
			<result mode="append">
				<listview mode="replace">
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name"  width="400"/>
						<attribute name="catalogVersion"  width="120"/>
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview mode="replace" >
					<itemlayout>
						<attribute name="code"  width="120"/>
						<attribute name="name"  width="400"/>
						<attribute name="catalogVersion"  width="120"/>
					</itemlayout>
				</treeview>
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SetProductsApprovedAction"
						name="action.catalog.setapproved" />
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SetProductsUnapprovedAction"
						name="action.catalog.setunapproved" />
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SetProductsCheckAction"
						name="action.catalog.setcheck" />
				<action type="searchresult"
						classname="de.hybris.platform.hmc.ext.catalog.SyncItemsSearchResultAction"
						name="action.catalog.syncproducts" />
				<action type="searchresult"
						classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard" />
				<action type="toolbar"
						classname="com.computationaldesign.wera.jalo.SampleWizard" name="samplewizard"/>
			</result>
			<editor>
				<essentials mode="append" ><!-- Name des Produkbilds -->
					<columnlayout>
						<row>
							<attribute name="desc_picture1"  /><!-- Name des Produktbilds -->
							<attribute name="check_artikelnr_index" width="420" /><!-- Alphanummerische Artikelnummer (mehrsprech. Print) -->
						</row>
					</columnlayout>
				</essentials>
				
				<!-- Tabs entfernen -->
				<tab name="tab.publications" mode="delete" />
				<tab name="tab.sync.settings" mode="delete" />
				<tab name="tab.categorysystem" mode="delete" />
				<tab name="tab.versions" mode="delete" />
				<tab name="product.descriptions" id="tab_product_descriptions" mode="delete" />
				<tab name="tab.catalog.classification" mode="delete" />
				<tab name="tab.product.features" mode="delete" />
				<tab name="product.prices" id="tab_europe1_prices" position="4" mode="delete" />
				<tab name="tab.product.properties" mode="delete" />
				<tab name="tab.variants" mode="delete"/>
				<tab name="tab.product.versions" mode="delete" />
				<tab name="tab.product.extendedattributes" mode="delete" />

				
				<!-- Stammdaten -->
				<tab name="tab.products" id="tab_product_common" mode="replace" position="1">
					
					<section name="section.allgemein">
						<listlayout>
							<!--						    <attribute name="aktiv" width="60" labelwidth="100" /> -->
							<attribute name="produkt_neu" width="60" />
							<attribute name="artikel_sb_faehig" width="60" labelwidth="100" />
							<attribute name="artikel_auslauf" width="60" labelwidth="100" />
							<attribute name="lagerNr" width="60" labelwidth="100" />
							<attribute name="artnr" width="60" labelwidth="100" />
							<attribute name="variantenNr" width="60" labelwidth="100" />
							<attribute name="variantenNrEU" width="60" labelwidth="100" />
							<attribute name="variantenNrUS" width="60" labelwidth="100" />
							<attribute name="contentQuantity" width="60" labelwidth="100" />
						</listlayout>
					</section>
					<section name="section.product.description">
						<listlayout>
							<attribute name="description1" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
							<attribute name="description2" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
							<attribute name="description3" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
						</listlayout>
					</section>
					<section name="section.abmessungen_und_gewichte">
						<columnlayout leftwidth="300" rightwidth="300" width="600">
							<row>
								<attribute name="artikel_laenge" 	labelwidth="150" width="100" />
								<attribute name="packm_laenge" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_hoehe" 	labelwidth="150" width="100" />
								<attribute name="packm_hoehe" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_breite" 	labelwidth="150" width="100" />
								<attribute name="packm_breite" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_volumen" 	labelwidth="150" width="100" />
								<attribute name="packm_volumen" 		labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="artikel_laengen_einheit" 	labelwidth="150" width="100" />
								<attribute name="packm_laengen_einheit" 	labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="Gewicht" 	labelwidth="150" width="100" />
								<attribute name="GewVE" 	labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="GewichtBrutto" 	labelwidth="150" width="100" />
							</row>
							<row>
								<attribute name="GewichtEinheit" 	labelwidth="150" width="100" />
								<attribute name="packm_gewichteh" 	labelwidth="150" width="100" />
							</row>
						</columnlayout>
					</section>
					
				</tab>
				
				<!-- Multimedia -->
				<tab name="tab.product.multimedia" mode="delete" />
				<tab name="multimedia" mode="replace" position="2">
					<section name="section.multimedia">
						<listlayout>
							<attribute name="icons1" >
