						<listlayout>
							<attribute name="code" />
						</listlayout>
					</section>
					<section name="section.wera.weblinktext.links">
						<listlayout>
							<attribute name="weblinktext2weblink">
								<referencecollectioneditor externalcreate="false" resortable="true" create="true" editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="link_wera_de" width="600" />
							<attribute name="preview_link_wera_de" width="600" />
							<attribute name="dam_media_name" width="600" />
							<attribute name="target_self" width="600" />
						</listlayout>
					</section>
					<section name="section.wera.weblinktext.videos">
						<columnlayout>
							<row>
								<attribute name="youtube_id" width="220"/>
								<attribute name="movie_type" width="220"/>
							</row>
							<row>
								<attribute name="movie_start_date" width="220"/>
								<attribute name="movie_template_id" width="220"/>
							</row>
							<row>
								<attribute name="movie_title" width="220"/>
								<attribute name="movie_subtitle" width="220"/>
							</row>
							<row>
								<attribute name="movie_tile_image_name" width="220"/>
								<attribute name="movie_detail_image_name" width="220"/>
							</row>
						</columnlayout>					
					</section>
					<section name="section.wera.weblinktext.wera_ar">
						<columnlayout>
							<row>
								<attribute name="ar_start_date" width="220"/>
								<attribute name="ar_preview" width="220"/>
							</row>
							<row>
								<attribute name="ar_tile_image_name" width="220"/>
								<attribute name="ar_tile_image2_name" width="220"/>
							</row>
							<row>
								<attribute name="ar_link" width="600"/>
							</row>
						</columnlayout>					
					</section>
					
				</tab>
			</editor>
		</organizer>
	</type>	

	
	<!-- Ext. Image  -->
	<type name="ExtImage">
		<organizer>
			<search mode="replace">
				<condition attribute="code" />
				<condition attribute="title" />
				<condition attribute="location" />
