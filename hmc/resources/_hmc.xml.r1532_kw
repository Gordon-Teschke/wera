	<!-- Category -->
	<type name="Category" mode="append" icon="/wera/images/e_kapitel_neu.gif">
		<organizer>
			<result mode="replace" defaultview="tree">
				<listview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
				</listview>
				<editview mode="delete" />
				<treeview>
					<itemlayout>
						<attribute name="code" />
						<attribute name="name" />
					</itemlayout>
					<explorable>
						<attribute name="categories" suppressroot="true" />
						<attribute name="products" suppressroot="true" />
					</explorable>
				</treeview>
			</result>
			<editor>

				<tab name="tab.properties" mode="delete" />
				<tab name="tab.wera.textpages" position="0">
					<section name="section.wera.textpages.infopage" mode="append">
						<listlayout>
							<attribute name="untertitel" width="500" />
							<attribute name="concat_description" width="500" />
							<attribute name="description" width="500" >
								<textareaeditor rows="15" expanded="true" />
							</attribute>
							
							<!-- SJ 2017-07-26: ausblenden zugunsten der Textfeld keywords 
							<attribute name="keywords" labelwidth="100" width="350">
								<referencecollectioneditor resortable="false" add="true" remove="true" create="true">
									<preset sourceattribute="catalogVersion" targetattribute="catalogVersion" />
									<itemlayout>
										<attribute name="keyword" width="150" />
										<attribute name="catalogVersion" width="150" />
									</itemlayout>
								</referencecollectioneditor>
							</attribute>
							-->
						</listlayout>
						<listlayout>
							<attribute name="order" width="50" />
							<attribute name="priorityWebSearch" width="50" />
							<attribute name="aktiv" width="50" />
							<!-- getilgt 29.07.2011 GT
								<attribute name="pagenr" width="50" />
							-->
						</listlayout>
					</section>
					<section name="section.icons">
						<listlayout>
							<attribute name="icons">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
				<tab name="tab.category.common" position="1" mode="append">
					<section name="section.category.description" mode="append">
						<listlayout>
							<attribute name="category2introtext" width="600">
								<referencecollectioneditor autoperform="true" create="true" remove="true" resortable="true">
                                    <itemlayout>
                                        <attribute name="code" width="200"/>
                                        <attribute name="text" width="400"/>
                                    </itemlayout>
								</referencecollectioneditor>
							</attribute>
							<attribute name="meta_description" width="600">
								<textareaeditor expanded="true" rows="3"/>
							</attribute>
							<attribute name="meta_keywords" width="600">
								<textareaeditor expanded="true" rows="3"/>
							</attribute>
						</listlayout>							
					</section>
				</tab>
				<tab name="tab.structure" position="1" mode="append">
					<section name="section.further_links">
						<listlayout>
							<attribute name="category2relcategories" labelwidth="100" width="300">
								<referencecollectioneditor externalcreate="false" resortable="true" create="true" editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="category2relproducts" labelwidth="100" width="300">
								<referencecollectioneditor externalcreate="false" resortable="true" create="true" editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
				</tab>
			
				<tab name="multimedia" position="2" mode="replace">
					<section name="pictures" mode="replace">
						<listlayout>
							<attribute name="picture" labelwidth="100">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
							<attribute name="thumbnail" labelwidth="100">
								<referencecollectioneditor
									externalcreate="false" resortable="true" create="true"
									editable="false" remove="true" add="true" autoperform="true" />
							</attribute>
						</listlayout>
					</section>
					<section name="section.additionalmedias" mode="replace">
						<listlayout>
							<attribute name="medias" labelwidth="100" >
								<referencecollectioneditor
