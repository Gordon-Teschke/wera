class NLDescription {
	CatalogVersion weraCatalogVersion = null;
	WeraManager wm = null;
	NLDescription(javax.servlet.http.HttpServletRequest req) {
			this.wm = WeraManager.getInstance();
			JaloSession jaloSession = null;
			try {
				jaloSession = WebSessionFunctions.getSession(req);
			} catch (Exception e) {
				e.printStackTrace();
			}

			UserManager userMg = jaloSession.getUserManager();
			String loginname = "";
			String password = "";
			try {
				// --- Get adminuser
				Employee customer = userMg.getAdminEmployee();

				// --- Initialize Logindata
				loginname = customer.getLogin();
				password = customer.getPassword();
			} catch (Exception e) {
				e.printStackTrace();
			}
			// set the new user to the jaloSession
			Properties prop = new Properties();
			prop.setProperty("user.principal", loginname);
			prop.setProperty("user.credentials", password);
			// the user is a customer
			prop.setProperty("session.type", "employee");

			try {
				// transfers the jaloSession to a different login
				jaloSession.transfer(prop);
			} catch (JaloSecurityException e) {
				e.printStackTrace();
			} catch (Exception e) {
				e.printStackTrace();
			}
	
	
		
		// --- wera catalog und catalogversion holen, oder ggf. neu anlegen
		final CatalogManager catalogManager = CatalogManager.getInstance();
		final ClassificationSystem weraCatalog = catalogManager.getClassificationSystem(Config.getParameter("wera.mastercatalog"));
		//ClassificationSystemVersion weraCatalogVersion = (ClassificationSystemVersion) weraCatalog.getActiveCatalogVersion();
		this.weraCatalogVersion = this.wm.getCatalogVersion(Config.getParameter("wera.mastercatalog"), Config
				.getParameter("wera.mastercatalogversion"));
				
	}

	String set(String sCode, String sDescription) {
		String sNLName = null;
		String sReturn = "";
		if ( this.weraCatalogVersion != null ) {
			if ( sCode.length() == 11 ) {
				String sSixDigitCode = sCode.substring(2,8);
				Product p = weraCatalogVersion.getProduct(sSixDigitCode);
				if ( p != null ) {
					if ( p instanceof WeraVariante ) {
						WeraVariante wv = (WeraVariante) p;
						sNLName = wv.getName();
						if ( 1 == 1 ) {
								wv.setName(sDescription);
								sReturn = "setting variant "+sSixDigitCode+" NL name to "+sDescription;
						} else {
								sReturn = "variant "+sSixDigitCode+" already has NL name = "+sNLName;
						}
						
						
						this.wm.SetLanguage("nl");
						Product baseProduct = wv.getBaseProduct();
						if ( baseProduct != null ) {
							sNLName = baseProduct.getName();
							if ( 1 == 1 ) {
								baseProduct.setName(sDescription);
								sReturn += ("; setting baseProduct "+baseProduct.getCode() +" of variant "+sSixDigitCode+" NL name to "+sDescription);
							} else {
								sReturn += ("; baseProduct "+baseProduct.getCode() +" of variant "+sSixDigitCode+" already has NL name = "+sNLName);
							}
							
						}
						
						this.wm.SetLanguage("de");
					}
				}
			}
		}
		return sReturn + "<br/>";
	}
}

