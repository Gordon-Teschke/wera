<items 	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
			xsi:noNamespaceSchemaLocation="items.xsd">
	<collectiontypes>
   	    <collectiontype code="WeraProductCollection"          elementtype="WeraProduct" autocreate="true" generate="true"  />
		<collectiontype code="WeraMediaCollection" 	          elementtype="WeraMedia" autocreate="true" generate="true" />
		<collectiontype code="OutputcontrolCollection"        elementtype="Outputcontrol" autocreate="true" generate="true" />
		<collectiontype code="ClassificationSystemVersionSet" elementtype="ClassificationSystemVersion" autocreate="true" generate="false" type="set"/>
		<collectiontype code="Category2ProductExtCollection"  elementtype="Category2ProductExt" autocreate="true" generate="true" />

	</collectiontypes>
	
	<enumtypes>
		<enumtype code="EinheitEnum" autocreate="true" generate="true">
			<value code="milligramm"/>
			<value code="gramm"/>
			<value code="kilogramm"/>
		</enumtype>		
		<enumtype code="SbClassificatrionEnum" autocreate="true" generate="true">
			<value code="classic"/>
			<value code="premium"/>
			<value code="premium_plus"/>
		</enumtype>		
	</enumtypes>
	
	<maptypes>
		<maptype code="localized:WeraProductCollection"
					argumenttype="Language"
					returntype="WeraProductCollection"
					autocreate="true"
					generate="false"/>	
	</maptypes>	
	
	<relations>
