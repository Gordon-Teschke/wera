	// --- Check if product belongs to this catalog via direct assignment or category assignment
	public boolean belongsToCatalogVersion(final CatalogVersion cv) {

		boolean bBelongsToCatalogVersion = false;
		CatalogVersion oProductsDirectCatalogVersion = null;
		try {
			oProductsDirectCatalogVersion = (CatalogVersion) this.getAttribute("catalogVersion");
		} catch (final JaloInvalidParameterException e) {
			// YTODO Auto-generated catch block
			e.printStackTrace();
		} catch (final JaloSecurityException e) {
			// YTODO Auto-generated catch block
			e.printStackTrace();
		}

		if (oProductsDirectCatalogVersion != null && oProductsDirectCatalogVersion.getVersion().equals(cv.getVersion())) {
			bBelongsToCatalogVersion = true;
		} else {
			Collection<Category> colSuperCats = null;
			try {
				colSuperCats = (Collection<Category>) this.getAttribute("supercategories");
				if (colSuperCats != null) {
					for (final Category oCat : colSuperCats) {
						final CatalogVersion oSuperCatsCatalogVersion = (CatalogVersion) oCat.getAttribute("catalogVersion");
						if (oSuperCatsCatalogVersion.getVersion().equals(cv.getVersion())) {
							bBelongsToCatalogVersion = true;
							break;
						}
					}
				}

			} catch (final JaloInvalidParameterException e) {
				// YTODO Auto-generated catch block
				e.printStackTrace();
			} catch (final JaloSecurityException e) {
				// YTODO Auto-generated catch block
				e.printStackTrace();
			}

		}
		if (!bBelongsToCatalogVersion) {
			LOG.info("belongsToCatalogVersion(): product " + this.getCode() + " does NOT belong to catalog version "
					+ cv.getVersion());
		}
		return bBelongsToCatalogVersion;
	}
	
