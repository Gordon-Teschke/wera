							//_debug( "found =" + ca.getCode());
							//log.info  ( getCode()+ ", "+ca.getCode()+"/"+ca.getName()+": "+caType.getCode() + " Feature: " + productFeature.getQualifier() + ", " + (String)productFeature.getAttribute("stringValue")  );
