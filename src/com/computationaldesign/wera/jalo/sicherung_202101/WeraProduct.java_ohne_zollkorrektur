	// --- Ersetzt für Bildnamens-Suche auf HD Sonderzeichen durch Filesystemvertr�gliche
	// --- Zeichen und normalisiert auf lower case.
	// --- Gibt normalisierten String zur�ck, oder null, falls das Produkt einen null Code hat.
	// --- STATIC Version
	public static String s_normalizeFilenameForImageLookup(String cProductNr) {

		try {
			if (cProductNr != null) {
				cProductNr = cProductNr.toLowerCase();
				cProductNr = cProductNr.replace(' ', '_');
				cProductNr = cProductNr.replace('/', '_');
				cProductNr = cProductNr.replace(',', '_');
				cProductNr = cProductNr.replace('#', '_');
				cProductNr = cProductNr.replace('+', '_');
				cProductNr = cProductNr.replace('(', '_');
				cProductNr = cProductNr.replace(')', '_');
				cProductNr = cProductNr.replace("\u00ae", ""); // Registered Zeichen ignorieren
				cProductNr = cProductNr.replace("\"", ""); // Zoll-Zeichen ignorieren
				cProductNr = cProductNr.replace("\u00f6", "oe");
				cProductNr = cProductNr.replace("\u00e4", "ae");
				cProductNr = cProductNr.replace("\u00fc", "ue");
				cProductNr = cProductNr.replace("\u00df", "ss");
			}
		} catch (final NullPointerException e) {
			// do nothing
		}
		return cProductNr;
	}

