		// --- Initialize
		final WeraManager wm = WeraManager.getInstance();
		final String strPicturePath = Config.getParameter("wera.homepath") + "/imagepool/pictures/";
		final String strNormalizedFileName = normalizeFilenameForImageLookup();
		final String strDestEPSFileName = strNormalizedFileName + ".eps";
		final String strDestJPGFileName = strNormalizedFileName + ".jpg";
		final String strDestTifFileName = strNormalizedFileName + ".tif";
		// final String strDestJPGFileName = strNormalizedFileName + "_rgb_300dpi.jpg";
		final String strDestJPGCMYKFileName = strNormalizedFileName + "_cmyk_300dpi.jpg";

		// --- Alte Version 2.2
		// WeraManager.getInstance().checkMedia(this, values);
		// --- Pr�fe ob der Name Picture 1 Bilder mit dem Code des Produkt übereinstimmt ---------------------------------------
		final Collection pictures = (Collection) wm.getAttribute(this, "pictures1");
		if (pictures != null && pictures.size() > 0) {
			// --- Hole das 1. Bild
			final WeraMedia oPicture1 = (WeraMedia) pictures.iterator().next();
			final String strRealName = (String) wm.getAttribute(oPicture1, "realfilename");
			boolean isEPS = ( strRealName != null && strRealName.endsWith(".eps"));
			boolean isJPG = ( strRealName != null && strRealName.endsWith(".jpg"));
			
			// --- Vergleiche, ob der Code noch übereinstimmt...
			int iPictureCheck = _checkCode2Picture();
			if ( iPictureCheck == 0 ) {
				// --- Debug Info
				log.info("checkMedia(): product image needs renaming for product "+getCode());

				boolean bRenameResult = false;
				String sImageExtention = isEPS ? ".eps" : ".jpg";
				String strRealNameWithoutExtension = strRealName.replace( sImageExtention , "" );

				// --- Dateien umbenennen
				if ( isEPS ) {
				    bRenameResult = _RenameFile(strPicturePath + strRealName, strPicturePath + strDestEPSFileName);
