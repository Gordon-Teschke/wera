	// ********************************************************************************
	// --- SJ 2006-06-29: Funktionen zum Zusammenstellen der Setdaten
	// --- generiert hierarchische Datenstruktur mit Zusammenstellung der benutzten
	//     Icons, Produktcodes,Artikel,CAs und durch Outputcontrol festgelegten, für die Ausgabe
	//     bestimmten Werte.
	//     Datenstruktur: siehe debugOutWeraProductSetData()
	public ArrayList _genCADataForVariantList(final Collection listVariants, final Collection listVarianteSet) {
		log.info("generateWeraProductSetData() called");
		// "variants" liefert Collection von WeraVarianteSet,
		// über die "weravariants" die zugeh�rige Artikelnummer

		// --- initialize
		HashMap<String, String> hashMapOcUnit = new HashMap();

		m_colWeraProductSetData = new ArrayList();
		m_colWeraProductSetFootnotes = new ArrayList();
		final WeraClassificationHelper weraclassificationhelper = new WeraClassificationHelper();

		try {
			Iterator iterVS = null;
			if (listVarianteSet != null) {
				iterVS = listVarianteSet.iterator();
			}
			for (final Iterator iter = listVariants.iterator(); iter.hasNext();) {
				final WeraVariante myWeraVariante = (WeraVariante) iter.next();

				Item weraVarSet = null;
				if (iterVS != null && iterVS.hasNext()) {
					weraVarSet = (Item) iterVS.next();
				}

				if (myWeraVariante != null) {

					// Produkt holen, dessen Artikel zum Set geh�rt
					final Product myBaseProduct = (Product) myWeraVariante.getAttribute("baseProduct");

					// Basis Produkt- und Artikeldaten schonmal ermitteln und hashen (icon1, icon2, order, produktnr)
					_initWeraProductSetData(myBaseProduct, myWeraVariante, weraVarSet);

					// Wir sammeln beim Durchlaufen der Outputcontrols alle Attributcodes.
					// Sp�ter updaten wir colWeraProductSetData mit den korrespondierenden Attributen
					final ArrayList colAttributeCodesFromOutputControls = new ArrayList();

					if (myBaseProduct != null) {
						final Collection myOutputControls = (Collection) myBaseProduct.getAttribute("outputcontrols");

						// Alle Outputcontrols des Produkts durchgehen
						for (final Iterator iterOC = myOutputControls.iterator(); iterOC.hasNext();) {
							final Outputcontrol myOC = (Outputcontrol) iterOC.next();
							/*
							 * getilgt 02.08.2011 GT Boolean bAktiv = myOC.isAktiv(); if (bAktiv == null) { bAktiv = new
							 * Boolean(false); }
							 */
							Boolean bInset = myOC.isShowinset();
							if (bInset == null) {
								bInset = new Boolean(false);
							}

							//if (bAktiv.booleanValue() && bInset.booleanValue())
							if (bInset.booleanValue()) {
								final String codeFromOC = myOC.getAttribute("code").toString();

								// --- merken unit-ca
								String strUnitCA = (String) myOC.getAttribute("unitca");
								if (strUnitCA != null) {
									if (!strUnitCA.equals("")) {
										hashMapOcUnit.put(codeFromOC, strUnitCA.toString());
									}
								}
								// --- merken unit-ca

								// Attributcode merken
								colAttributeCodesFromOutputControls.add(codeFromOC);
							}
						}

						_updateCAInWeraProductSetData(myBaseProduct, colAttributeCodesFromOutputControls);

					}

				}

			}

			// --- Varianten im MasterHash richtig sortieren (nach order)
			_sortVariantsInWeraProductSetData();

			// --- Produkte im MasterHash richtig sortieren (nach Code alphabetisch!)
			// _sortProductsInWeraProductSetData();
			// --- F�r alle Produkte im Set und für alle Artikel darin die eigentlichen Values festlegen
			for (final Iterator iterProduct = m_colWeraProductSetData.iterator(); iterProduct.hasNext();) {

				final HashMap productHash = (HashMap) iterProduct.next();
				final Collection colVariants = (Collection) productHash.get("colHashArtikel");
				final Collection colCA = (Collection) productHash.get("colCA");
				//final Collection colCA = (Collection) productHash.get("colCAAll");
				final HashMap mapCA2Inch = (HashMap) productHash.get("mapCA2Inch");

				// --- last CA
				ClassificationAttribute lastCA = null;

				for (final Iterator iterVariant = colVariants.iterator(); iterVariant.hasNext();) {
					final HashMap variantHash = (HashMap) iterVariant.next();
					final WeraVariante myVariant = (WeraVariante) variantHash.get("variant");
					int myVariantQuantity = 0;
					try {
						final Integer tmpInteger = (Integer) variantHash.get("contentQuantity");
						if (tmpInteger != null) {
							myVariantQuantity = tmpInteger.intValue();
						}
					} catch (final Exception e) {
						e.printStackTrace();
					}

					String stringValue = "";
					for (final Iterator iterCA = colCA.iterator(); iterCA.hasNext();) {
						String stringCAValue = "";

						final ClassAttributeAssignment myCAA = (ClassAttributeAssignment) iterCA.next();

						final ClassificationAttribute myCA = myCAA.getClassificationAttribute();

						// --- Hole Type
						final EnumerationValue type = myCAA.getAttributeType();

						final HashMap<String, ClassificationAttributeValue> hCav = weraclassificationhelper
								.getPickedClassificationAttributeValuesByProduct(myVariant, myCAA);
						final Collection colProductFeatures = hCav.values();
						//Collection colProductFeatures  = getProductFeatures(myVariant,myCA);

						for (final Iterator iterNeededPF = colProductFeatures.iterator(); iterNeededPF.hasNext();) {
							final ClassificationAttributeValue classificationattributevalue = (ClassificationAttributeValue) iterNeededPF
									.next();
							if (type.getCode().equals(GeneratedCatalogConstants.Enumerations.ClassificationAttributeTypeEnum.STRING)) {

								if (!stringCAValue.equals("")) {
									stringCAValue += ",";
								}
								String sValueItem = null;
								if (classificationattributevalue != null) {
									final String sValue = classificationattributevalue.getName();

									if (sValue == null) {
										LOG.info("_genCADataForVariantList() could not find non-emtpy value for FeatureValue "
												+ classificationattributevalue.getCode() + ", trying german value...");

										final Language oAktLang = JaloSession.getCurrentSession().getSessionContext().getLanguage();
										JaloSession.getCurrentSession().getSessionContext()
												.setLanguage(C2LManager.getInstance().getLanguageByIsoCode("de"));
										sValueItem = classificationattributevalue.getName();
										JaloSession.getCurrentSession().getSessionContext().setLanguage(oAktLang);

									} else {
										sValueItem = (String) classificationattributevalue.getAttribute("name");
									}
								} else {
									log.info("classificationattributevalue is null, cannot get attribute name");
								}
								if (sValueItem == null || sValueItem.trim().equals("-")) {
									sValueItem = "";
								} else {
									sValueItem = sValueItem.replace("\u00b4", "");
									sValueItem = sValueItem.replace("\"", "##dq##");
								}
								if (mapCA2Inch != null) {
									final String sUseInch = (String) mapCA2Inch.get(myCA);
									String sCAName = myCA.getName();
									if (sCAName == null) {
										sCAName = "";
									}

									if (sUseInch != null
											&& (sUseInch.equals("1") || sCAName.toLowerCase().contains("zoll") || (sValueItem.contains("/") && !(myCA
											.getCode().equals("AAA972f001")
											|| myCA.getCode().equals("AAC551f001")
											|| myCA.getCode().equals("AAA358f001")
											|| myCA.getCode().equals("_AAA972f001")
											|| myCA.getCode().equals("_00011f001"))))) {
										if (sValueItem.isEmpty() || sValueItem.equals("-")) {
											sValueItem = "";
										} else {
											// --- Zollzeichen
											sValueItem = sValueItem.replaceAll("##dq##", "\"");
											//sValueItem += "\"";
										}
									}

								}

								stringCAValue += sValueItem;
							}

						}

						// --- leere CA Values auslassen
						stringCAValue = stringCAValue.trim();
						if (stringCAValue.length() > 0) {
							// --- Hole Unit ----------------------------------------
							String stringUnit = null;
							final ClassificationAttributeUnit oUnit = myCAA.getUnit();
							//oUnit = classificationattribute.getUnitForCategory(JaloSession.getCurrentSession().getSessionContext(), oCategory);
							if (stringUnit == null || stringUnit.length() == 0) {
								if (oUnit != null) {
									stringUnit = oUnit.getUnitType();
								}
							}
							// --- unit aus oc holen
							if (hashMapOcUnit.containsKey(myCA.getCode())) {
								stringUnit = hashMapOcUnit.get(myCA.getCode());
							}
							if (stringUnit == null) {
								stringUnit = "";
							}
							// --- Hole Unit ----------------------------------------

							if (!stringValue.equals("")) {
								// --- pr�fe
								if ((lastCA != null && lastCA.getCode().equals("_00011f001")) || myCA.getCode().equals("_00003f001")) {
									// --- letztes CA war Artikelnummer, daher ein Leezeichen als Trenner
									// oder akteulles ist ein Messbereich
									if (!stringUnit.equals("") && !stringUnit.equals("mm") && !stringUnit.equals("inch")) {
										stringValue += ", ";

										// --- unit hinzuf�gen
										stringCAValue += " " + stringUnit;
									} else {
										stringValue += ", ";
									}

								} else {
									stringValue += "x";
								}
							}

							// --- Wert anh�ngen
							stringValue += stringCAValue;
						}

						// --- letze ca merken
						lastCA = myCA;

					}

//System.out.println("(v) stringValue=" + stringValue);
					// --- bereiginigen
					stringValue = stringValue.replaceAll("--x", "");
//System.out.println("(n) stringValue=" + stringValue);

					// --- übernehmen!
					if (stringValue.trim().length() > 0) {

						//log.info ( "myVariantQuantity=" + myVariantQuantity +  ", stringValue=>" +stringValue + "<" );
						variantHash.put("value", myVariantQuantity + "x " + stringValue);
					} else {
						variantHash.put("value", "");
					}

				}
			}
		} catch (final Exception e) {
			e.printStackTrace();
		}

		// --- fussnoten
		_genFootnotes();

		log.info("#+#+#generateWeraProductSetData() ende =" + getCode() );

		return m_colWeraProductSetData;
	}


	/*
	 * private static void _initWeraProductSetData(final Product product, final WeraVariante variante, final
	 * WeraVarianteSet varianteSet)
	 */
	private void _initWeraProductSetData(final Product product, final WeraVariante variante, final Item varianteSet) {
		//log.info ("WeraProductSet::_initWeraProductSetData() called");

		// --- Initialize
		boolean bFound = false;
		HashMap myHash = null;
		HashMap newHash = null;
		final WeraManager wm = WeraManager.getInstance();

		if (m_colWeraProductSetData != null && product != null && variante != null) {
			Collection myOutputControls = null;
			try {
				myOutputControls = (Collection) product.getAttribute("outputcontrols");
			} catch (final Exception e) {
				e.printStackTrace();
			}
			for (final Iterator i = m_colWeraProductSetData.iterator(); i.hasNext();) {
				myHash = (HashMap) i.next();
				if (myHash.get("code").equals(product.getCode())) {
					bFound = true;
					break;
				}
			}

			// Product-HashMap neu anlegen und initialisieren
			if (bFound == false) {
				Integer iOrder = null;
				String strArtrNr = product.getClass() + "=>strArtrNr";
				String strLagerNr = product.getClass() + "=>strLagerNr";
				String strVariantenNr = product.getClass() + "=>strVariantenNr";
				String strEAN = product.getClass() + "=>strEAN";
				String strVPE = product.getClass() + "=>strVPE";
				try {
					iOrder = (Integer) product.getAttribute("order");
					if (product instanceof WeraProductSet) {
						strArtrNr = (String) product.getAttribute("artnr");
					} else {
						strArtrNr = (String) variante.getAttribute("code");
					}
					strLagerNr = (String) variante.getAttribute("lagerNr");
					strVariantenNr = (String) variante.getAttribute("variantenNr");
					strEAN = (String) variante.getAttribute("ean");
					Integer oVPE = (Integer) variante.getAttribute("contentQuantity");
					if (oVPE == null) {

						strVPE = "1";

					} else {

						strVPE = oVPE.toString();
					}
				} catch (final Exception e) {
					e.printStackTrace();
				}
				newHash = new HashMap();
				newHash.put("artnr", strArtrNr);
				newHash.put("lagernr", strLagerNr);
				newHash.put("variantennr", strVariantenNr);
				newHash.put("ean", strEAN);
				newHash.put("vpe", strVPE);
				newHash.put("code", product.getCode());
				newHash.put("icons1", null);
				newHash.put("icons1_collection", new ArrayList());
				newHash.put("icons2", null);
				newHash.put("icons2_collection", new ArrayList());
				newHash.put("colHashArtikel", new ArrayList());
				newHash.put("colCA", new ArrayList());
				newHash.put("colCAAll", null);
				newHash.put("order", iOrder);
				newHash.put("pk", product.getPK());
				newHash.put("name", "name=" + product.getName());

				if (m_setHalterCodes.contains(product.getCode())) {
					newHash.put("isNoHandhalter", new String("0"));
				} else {
					newHash.put("isNoHandhalter", new String("1"));
				}

				Collection col1 = null;
				Collection col2 = null;
				try {
					col1 = (Collection) ((WeraProduct) product).getAttribute("icons1");
					col2 = (Collection) ((WeraProduct) product).getAttribute("icons2");
				} catch (final Exception e) {
					e.printStackTrace();
