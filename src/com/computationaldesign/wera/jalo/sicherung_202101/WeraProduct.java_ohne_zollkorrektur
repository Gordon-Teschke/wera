	// --- Hole alle angelegten Datenfelder (Portalclassifizierung)
	public static ArrayList getAllDatenfelder() {

		// --- Initiliaze
		final ArrayList colMerkmale = new ArrayList();
		ArrayList colAllowedList = new ArrayList();
		colAllowedList.addAll(Arrays.asList("pk"));

		// --- Schleife über alle Felder
		final Collection descriptors = TypeManager.getInstance().getComposedType(WeraProduct.class).getAttributeDescriptors();
		for (final Iterator it1 = descriptors.iterator(); it1.hasNext();) {
			// --- Hole Attribut-describtor
			final AttributeDescriptor oAD = (AttributeDescriptor) it1.next();
			if (oAD.isWritable() || colAllowedList.contains(oAD.getQualifier())) {

				// --- Filter nach GrundTypen und MediaObjekten
				if (!(oAD.getAttributeType() instanceof de.hybris.platform.jalo.type.AtomicType)
						&& !(oAD.getAttributeType().toString().equals("Collection(WeraMedia)"))) {
					continue;
				}

				final HashMap hMerkmal = new HashMap();
				hMerkmal.put("name", oAD.getQualifier());
				hMerkmal.put("visibility", "Produkt");
				if (oAD.getName() == null) {
					hMerkmal.put("description", oAD.getQualifier());
				} else {
					hMerkmal.put("description", oAD.getName());
				}
				hMerkmal.put("type", oAD.getAttributeType().getName());
				hMerkmal.put("namespace", "WeraProduct@hybris/core");
				colMerkmale.add(hMerkmal);

			}

		}

		return colMerkmale;
	}

