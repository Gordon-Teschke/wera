class FieldComparatorString implements Comparator {

	String m_strCompareField = "code";

	public void setCompareField(final String strField) {
		if (strField != null && strField.length() > 0) {
			m_strCompareField = strField;
		}
	}

	private String _CutRight(String strValue, final String strChar) {

		final int iPos = strValue.indexOf(strChar);
		if (iPos > 0) {
			strValue = strValue.substring(0, iPos);
		}
		return strValue;
	}

	public int compare(final Object o1, final Object o2) /* descending order */ {

		// --- Initialize
		String strValue1 = "";
		String strValue2 = "";
		final int iResult = 0;
		try {

			// --- Hole Values I
			if (o1 != null) {
				strValue1 = (String) ((Item) o1).getAttribute(m_strCompareField);
				if (strValue1 != null && strValue1.length() > 0) {
					final char cFirst = strValue1.charAt(0);
					if (48 <= cFirst && cFirst <= 59) {
						strValue1 = WeraProduct.s_normalizeFilenameForImageLookup(strValue1);
						strValue1 = _CutRight(strValue1, "_");
						strValue1 = _CutRight(strValue1, "-");
						final String newValue1 = "00" + strValue1;
						strValue1 = newValue1.substring(newValue1.length() - 4);
					}
				}
			} else {
				strValue1 = "";
			}

			// --- Hole Values II
			if (o2 != null) {
				strValue2 = (String) ((Item) o2).getAttribute(m_strCompareField);
				if (strValue2 != null && strValue2.length() > 0) {
					final char cFirst = strValue2.charAt(0);
					if (48 <= cFirst && cFirst <= 59) {
						strValue2 = WeraProduct.s_normalizeFilenameForImageLookup(strValue2);
						strValue2 = _CutRight(strValue2, "_");
						strValue2 = _CutRight(strValue2, "-");
						final String newValue2 = "00" + strValue2;
						strValue2 = newValue2.substring(newValue2.length() - 4);
					}
				}
			} else {
				strValue2 = "";
			}

		} catch (final JaloInvalidParameterException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (final JaloSecurityException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

		if (strValue1 == null || strValue2 == null) {
			return 0;
		} else {
			return strValue1.compareTo(strValue2);
		}
	}
}

