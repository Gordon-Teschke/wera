	/**
	 * content-info f�r alle Varianten
	 * 
	 * @param string lang_iso
	 * @return Map<String, String>
	 */
	public Map<String, String> getContentInfoForVariants ( final String lang_iso ) {
	    HashMap<String, String> hMap = new HashMap();
	    // Connection myCon = this._init_datawarehouse_db();
	    Connection myCon = WeraManager.getDWHConnection();
	    Collection<String> colVariantCodes = new ArrayList();

	    // --- Hole alle Produkte
	    Collection<VariantProduct> colVariantProducts = null;
	    try {
		    colVariantProducts = (Collection<VariantProduct>) getAttribute("variants");
	    } catch (final JaloInvalidParameterException e) {
		    // TODO Auto-generated catch block
		    e.printStackTrace();
	    } catch (final JaloSecurityException e) {
		    // TODO Auto-generated catch block
		    e.printStackTrace();
	    }

	    if (colVariantProducts != null) {
		for (final VariantProduct variant : colVariantProducts) {
		    if (variant instanceof WeraVariante) {
			WeraVariante wv = (WeraVariante) variant;
			colVariantCodes.add( wv.getLagerNr() + wv.getCode() + wv.getVariantenNr());
		    }
		}
	    }

	    String sWhereClause = StringUtils.join( colVariantCodes, "\",\"");
	    try {
		PreparedStatement preparedStmt = myCon.prepareStatement("select product_id, content_info from products_merged where product_id in (\""+sWhereClause+"\") and lang_iso=?");
		preparedStmt.setString(1, lang_iso);
		final ResultSet rsContentInfo = preparedStmt.executeQuery();
		while (rsContentInfo.next()) {
		    final String productId = rsContentInfo.getString("product_id");
		    final String contentInfo = rsContentInfo.getString("content_info");
		    hMap.put(productId, contentInfo);
		}	    
	    } catch (final SQLException e) {
		LOG.error("ERROR retrieving content_info from products_merged for product = "+this.getCode()+" and lang_iso="+lang_iso);
	    }
	    try {
		if (!myCon.isClosed()) {
		    myCon.close();
		    LOG.info("getContentInfo(): mysql connection closed.");
		} else {
		    LOG.warn("getContentInfo(): mysql connection already closed or invalid!");
		}
	    } catch (final SQLException e) {
		LOG.error("getContentInfo(): error trying to close mysql connection.");
	    }
	    return hMap;	
	}	
	
