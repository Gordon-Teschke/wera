	/**
	 *
	 */
	private void updateVariantMandatoryFeatures() {
		LOG.info("updateVariantMandatoryFeatures(): START");
		LOG.info("updateVariantMandatoryFeatures(): Checking for eligible CAAs for value propagation ...");
		Collection<WeraVariante> colVariants = null;
		// --- Hole alle Produkte
		try {
			colVariants = (Collection) getAttribute("variants");
		} catch (final JaloInvalidParameterException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (final JaloSecurityException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

		if (colVariants != null) {
			// if there are any variants we have to get the base products set of mandatory proficlass attributes,
			// which are visible in the base product only.
			Collection<ClassificationClass> colClasses = null;
			try {
				colClasses = (Collection<ClassificationClass>) getAttribute("classificationClasses");
			} catch (final JaloInvalidParameterException e1) {
				// YTODO Auto-generated catch block
				e1.printStackTrace();
			} catch (final JaloSecurityException e1) {
				// YTODO Auto-generated catch block
				e1.printStackTrace();
			}

			// prepare visibility constant for comparison
			final EnumerationManager em = EnumerationManager.getInstance();
			final EnumerationType et = em.getEnumerationType("ClassificationAttributeVisibilityEnum");
			final EnumerationValue evVISIBLE_IN_VARIANT = em.getEnumerationValue(et, "VISIBLE_IN_VARIANT");

			for (final ClassificationClass oClass : colClasses) {
				{

					// Nur für ProfiClass 3.0 prüfen - alles andere zu langsam
					if (oClass.getSystemVersion().getVersion().equals("3.0")) {
						final Collection<ClassAttributeAssignment> colCAA = oClass.getClassificationAttributeAssignments();
						for (final ClassAttributeAssignment caa : colCAA) {
							Boolean oMandatory = null;
							try {
								oMandatory = caa.isMandatory();
							} catch (final JaloInvalidParameterException e) {
								// YTODO Auto-generated catch block
								e.printStackTrace();
							}

							if (oMandatory != null && oMandatory.booleanValue()) {
								final EnumerationValue ev = caa.getVisibility();
								final EnumerationValue caType = caa.getAttributeType();

								if (ev != null && !ev.equals(evVISIBLE_IN_VARIANT)) {
									// this class attribute assignment is mandatory and not visible in variant,
									LOG.info("updateVMF(): CAA (" + oClass.getCode() + " - " + oClass.getName() + " / "
											+ caa.getClassificationAttribute().getCode() + " - "
											+ caa.getClassificationAttribute().getName() + ") is mandatory and invisible for variants");
									for (final WeraVariante wv : colVariants) {

										if (caType.getCode().equals(
												GeneratedCatalogConstants.Enumerations.ClassificationAttributeTypeEnum.BOOLEAN)) {
											final TypedFeature<Boolean> featureVariant = Feature.loadTyped(wv, caa);
											if (featureVariant == null || featureVariant.isEmpty()) {
												// get BOOLEAN feature from product
												final TypedFeature<Boolean> featureBase = Feature.loadTyped(this, caa);
												Boolean oBooleanValue = null;
												if (featureBase != null && !featureBase.isEmpty()) {
													final FeatureValue<Boolean> featurevalueBase = featureBase.getValue(0);
													oBooleanValue = featurevalueBase.getValue();
													LOG.info("updateVMF(): propagating base product >" + this.getCode()
															+ "<'s BOOLEAN value >" + oBooleanValue.toString() + "< to variant >" + wv.getCode()
															+ "<");
												} else {
													oBooleanValue = new Boolean(false);
													LOG.info("updateVMF(): initializing variant >" + wv.getCode() + "<'s BOOLEAN value to >"
															+ oBooleanValue.toString() + "< because " + this.getCode()
															+ "< has no appropriate feature.");

												}
												featureVariant.clearAll();
												featureVariant.createValue(oBooleanValue);
												try {
													featureVariant.getParent().store();
													LOG.info("updateVMF(): BOOLEAN value stored successfully.");
												} catch (final ConsistencyCheckException e) {
													e.printStackTrace();
												}
												continue;
											}
										}
										if (caType.getCode().equals(
												GeneratedCatalogConstants.Enumerations.ClassificationAttributeTypeEnum.STRING)) {
											final TypedFeature<String> featureVariant = Feature.loadTyped(wv, caa);
											if (featureVariant == null || featureVariant.isEmpty()) {
												// get STRING feature from product
												final TypedFeature<String> featureBase = Feature.loadTyped(this, caa);
												String oStringValue = null;
												if (featureBase != null && !featureBase.isEmpty()) {
													final FeatureValue<String> featurevalueBase = featureBase.getValue(0);
													oStringValue = featurevalueBase.getValue();
													LOG.info("updateVMF(): propagating base product >" + this.getCode() + "<'s STRING value >"
															+ oStringValue + "< to variant >" + wv.getCode() + "<");
												} else {
													oStringValue = "0";
													LOG.info("updateVMF(): initializing variant >" + wv.getCode() + "<'s STRING value to >"
															+ oStringValue + "< because " + this.getCode() + "< has no appropriate feature.");
												}
												featureVariant.clearAll();
												featureVariant.createValue(oStringValue);
												try {
													featureVariant.getParent().store();
													LOG.info("updateVMF(): STRING value stored successfully.");
												} catch (final ConsistencyCheckException e) {
													e.printStackTrace();
												}
												continue;
											}
										}
										if (caType.getCode().equals(
												GeneratedCatalogConstants.Enumerations.ClassificationAttributeTypeEnum.NUMBER)) {
											final TypedFeature<Number> featureVariant = Feature.loadTyped(wv, caa);
											if (featureVariant == null || featureVariant.isEmpty()) {
												// get NUMBER feature from product
												final TypedFeature<Number> featureBase = Feature.loadTyped(this, caa);
												Double oDoubleValue = null;
												if (featureBase != null && !featureBase.isEmpty()) {
													final FeatureValue<Number> featurevalueBase = featureBase.getValue(0);
													oDoubleValue = (Double) featurevalueBase.getValue();
													LOG.info("updateVMF(): propagating base product >" + this.getCode() + "<'s DOUBLE value >"
															+ oDoubleValue.toString() + "< to variant >" + wv.getCode() + "<");
												} else {
													oDoubleValue = new Double(0);
													LOG.info("updateVMF(): initializing variant >" + wv.getCode() + "<'s DOUBLE value  to >"
															+ oDoubleValue.toString() + "< because" + this.getCode()
															+ "< has no appropriate feature.");
												}
												featureVariant.clearAll();
												featureVariant.createValue(oDoubleValue);
												try {
													featureVariant.getParent().store();
													LOG.info("updateVMF(): DOUBLE value stored successfully.");
												} catch (final ConsistencyCheckException e) {
													e.printStackTrace();
												}
												continue;
											}
										}

									}

								}
							}
						}
					}

				}

			}
		}
		LOG.info("updateVariantMandatoryFeatures(): END");
	}

