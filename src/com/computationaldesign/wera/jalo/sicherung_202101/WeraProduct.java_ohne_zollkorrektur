	/**
	 *
	 * @param strOrgFileName
	 * @param strNewFileName
	 * @return
	 */
	private boolean _RenameFile(final String strOrgFileName, final String strNewFileName) {

		// --- Initialize
		boolean bRenameResult = false;

		// --- Dateien umbenennen
		try {
			if (new File(strOrgFileName).exists()) {
				// --- Datei umbenennen
				bRenameResult = new File(strOrgFileName).renameTo(new File(strNewFileName));
				log.info("Datei wird umbenannt alt=" + strOrgFileName + " / neu=" + strNewFileName);
			} else {
				log.warn("Datei " + strOrgFileName + " existiert nicht.");
			}

		} catch (final Exception e) {
			log.error("Fehler beim umbenennen alt=" + strOrgFileName + " / neu=" + strNewFileName);
			e.printStackTrace();
		}

		return bRenameResult;
	}

	/**
	 * Vergleichen der Code - Nummer mit Hauptbild
	 *
	 * @returns 0, if image filename is incorrect, returns 1 if image filename matches lagacy EPS format, or 2 if image filename matches JPG format
	 */
	private int _checkCode2Picture() {
		log.info("_checkCode2Picture(): start");
		// --- Initalize
		final WeraManager wm = WeraManager.getInstance();
		int iResult = 0;
		final String strDestEPSFileName = normalizeFilenameForImageLookup() + ".eps";
		final String strDestJPGFileName = normalizeFilenameForImageLookup() + ".jpg";

		// --- Hole der Produktbild
		final Collection pictures = (Collection) wm.getAttribute(this, "pictures1");
		if (pictures != null && pictures.size() > 0) {

			// --- Hole das 1. Bild
			final WeraMedia oPicture1 = (WeraMedia) pictures.iterator().next();
			final String strRealName = (String) wm.getAttribute(oPicture1, "realfilename");

			// --- Vergleiche, ob der Code noch übereinstimmt...
			if (oPicture1.getCode().equals(strDestEPSFileName) && strRealName.equals(strDestEPSFileName)) {
				// --- Bild passt auf Legacy EPS Format, ok
				iResult = 1;
				log.info("_checkCode2Picture(): assigned product image is LEGACY EPS");
			} else {
			    if (oPicture1.getCode().equals(strDestJPGFileName) && strRealName.equals(strDestJPGFileName)) {
				    // --- Bild passt auf JPG Format, ok
				    iResult = 2;
				    log.info("_checkCode2Picture(): assigned product image is JPG");
			    } else {
				    log.info("_checkCode2Picture(): assigned product image has wrong name!");		    
			    }
			}

		} else {
		    log.info("_checkCode2Picture(): no assigned product image!");		    
		}
		
		return iResult;
	}

