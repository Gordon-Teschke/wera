	/**
	 * Hole alle Produkte einer Katelogversion
	 *
	 * @param CatalogVersion catalogversion
	 * @param boolean bSortIt
	 * @param String strSortBy
	 * @param Collection colFilter
	 * @return Collection
	 */
	private static Collection _getAllProductsFromAnyCatalog(final CatalogVersion catalogversion, final boolean bSortIt,
			final String strSortBy, Collection colFilter /*=null*/, boolean bExportSBVariants/* false */) {
		// --- Initialize
		if (colFilter == null) {
			colFilter = new ArrayList();
			colFilter.add("VERKAUFSHILFE");
			colFilter.add("PREISLISTENARTIKEL");
		}

		ArrayList<WeraProduct> weraproductslist = new ArrayList();
		ArrayList<WeraProduct> productsTmp = new ArrayList();

		// --- Hole alle Kategorien des Katalogs
		final ArrayList categories = new ArrayList();
		categories.addAll(catalogversion.getAllCategories());

		// --- Schleife über alle Kategorien
		for (final Iterator it1 = categories.iterator(); it1.hasNext();) {
			// -- Get Category
			final Category oCategory = (Category) it1.next();

			// --- Keine klassifizieren Klassen
			if (oCategory instanceof ClassificationClass) {
				LOG.info("++ SKIP klassifizierte Kategorie = " + oCategory.getCode());
				continue;
			}

			// --- Auslassen
			//if (oCategory.getCode().equals("VERKAUFSHILFE") || oCategory.getCode().equals("PREISLISTENARTIKEL"))
			if (colFilter.contains(oCategory.getCode())) {
				LOG.info("++ SKIP Kategorie = " + oCategory.getCode());
				continue;
			}

			// --- Categorie übernehmen und Produkte sammeln
			final List aList = oCategory.getProducts();
			LOG.info("++ read Category = " + oCategory.getCode() + ", anzahl products=" + aList.size());
			if (aList != null && aList.size() > 0) {
				productsTmp.addAll(aList);
			}

		} // --- for ( Iterator it1 = categories.iterator(); it1.hasNext();)

		// --- Sollen die Prokdute sortiert werden
		if (productsTmp != null && productsTmp.size() > 0 && bSortIt) {
			// --- Filtere aktive WeraProduct / WeraProductSet / WeraProductSetinSet
			for (WeraProduct oWeraProduct : productsTmp) {

				// --- Ist das Produkt aktiv, bzw. in einer aktiven Kategorie
				if (oWeraProduct instanceof WeraProduct || oWeraProduct instanceof WeraProductSet || oWeraProduct instanceof WeraProductSetinSet) {
					if (oWeraProduct._IsAktiv(catalogversion)) {
						weraproductslist.add(oWeraProduct);
					}
				}
			}

			// --- Sortiere nach CODE-Nummer
			final FieldComparatorString oFieldcomparatorstring = new FieldComparatorString();
			oFieldcomparatorstring.setCompareField(strSortBy);
			Collections.sort(weraproductslist, oFieldcomparatorstring);
		} else {
			weraproductslist.addAll(productsTmp);
		}

		// --- SB-Varianten anf�gen -----------------------------------------------------------------------
		if (bExportSBVariants) {

			// --- preset tmp-array
			productsTmp.clear();
			productsTmp.addAll(weraproductslist);
			weraproductslist.clear();

			// --- iterate on all collected produtcs
			for (WeraProduct oWeraProduct : productsTmp) {

				// --- hole alle SB-Varianten
				Collection<WeraProductSetinSet> colSBVariants = getAllSB_Variants(oWeraProduct);

				// --- weraproduct und sb-varianten anf�gen
				weraproductslist.add(oWeraProduct);
				weraproductslist.addAll(colSBVariants);

			}

		} // --- if { bExportSBVariants ) {
		// --- SB-Varianten anf�gen -----------------------------------------------------------------------

		return weraproductslist;
	}

