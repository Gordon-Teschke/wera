	/**
	 * get the first occurens of a product / category relation from a given
	 * Catalogversion
	 *
	 * @param String strCatalogversion
	 * @return Category oFirstCategory - found category, or null
	 */
	public Category getFirstCategoryByProduct(final String strCatalogversion) {

		// --- initialize
		final WeraManager wm = WeraManager.getInstance();
		Category oWebCategory = null;
		Category oWeramasterCategory = null;

		// --- get all category information ---------------------------------------------------------------------
		final Collection<Category> supercategories = (Collection<Category>) wm.getAttribute(this, "supercategories");
		for (final Category cm : supercategories) {
			final CatalogVersion categoryCatalogVersion = (CatalogVersion) wm.getAttribute(cm, "catalogVersion");
			if (categoryCatalogVersion != null && categoryCatalogVersion.getVersion().equals(strCatalogversion)) {
				oWebCategory = cm;
				break;
			}
		} // --- for (final Category cm : supercategories)

		if (oWebCategory != null) {
			for (final Category cm : supercategories) {
				final CatalogVersion categoryCatalogVersion = (CatalogVersion) wm.getAttribute(cm, "catalogVersion");
				if (categoryCatalogVersion != null && categoryCatalogVersion.getVersion().equals("weramaster")
						&& cm.getCode().equals(oWebCategory.getCode())) {
					oWeramasterCategory = cm;
					break;
				}
			} // --- for (final Category cm : supercategories)
		}

		// use path of web category only if no corresponding weramaster category with the same code exists
		if (oWebCategory != null) {
			oWebCategory = oWebCategory;
			if (oWeramasterCategory != null) {
				oWebCategory = oWeramasterCategory;
			}
		}

		// --- get all category information ---------------------------------------------------------------------
		return oWebCategory;
	}

	// --- Gleicht "colCA" Feld im WeraProductSetData Hash ab gegen colCodes und sortiert diese
	private void _updateCAInWeraProductSetData(final Product product, final Collection colCodes) {
		//log.info ("WeraProductSet::_updateCAInWeraProductSetData() called");

		HashMap myHash = null;

		for (final Iterator i = m_colWeraProductSetData.iterator(); i.hasNext();) {
			myHash = (HashMap) i.next();
			if (myHash.get("code").equals(product.getCode())) {
				final Collection colAllCA = (Collection) myHash.get("colCAAll");
				final Collection colCA = (Collection) myHash.get("colCA");

				// Bereitstellen und Sortieren der CAs nur wenn nicht schon geschehen
				if (colCA.size() == 0) {
					for (final Iterator ic = colAllCA.iterator(); ic.hasNext();) {
						final ClassAttributeAssignment caa = (ClassAttributeAssignment) ic.next();
						final ClassificationAttribute ca = caa.getClassificationAttribute();
						if (colCodes.contains(ca.getCode())) {
							colCA.add(caa);
							//log.info ("_updateCAInWeraProductSetData(): adding CA " + ca.getCode());
						}
					}

					// Sortieren der benutzten CAs
					final OrderCtrlComparator orderctrl_comparator = new OrderCtrlComparator();
					orderctrl_comparator.setProduct(product);
					Collections.sort((List) colCA, orderctrl_comparator);
				}
			}
		}

	}

	private void _sortVariantsInWeraProductSetData() {
		log.info("_sortVariantsInWeraProductSetData() (S) called");

		if (m_colWeraProductSetData != null) {
			for (final Iterator iMaster = m_colWeraProductSetData.iterator(); iMaster.hasNext();) {
				final HashMap productMap = (HashMap) iMaster.next();
				final Collection myVariantMaps = (Collection) productMap.get("colHashArtikel");
				final ArrayList myNewVariantMaps = new ArrayList();

				final int iSize = myVariantMaps.size();

				for (int j = 0; j < iSize; j++) {
					HashMap tmpHash = null;
					int iMinOrder = Integer.MAX_VALUE;

					for (final Iterator i = myVariantMaps.iterator(); i.hasNext();) {
						final HashMap variantHash = (HashMap) i.next();
						int iVariantOrder = -1;
						try {
							iVariantOrder = ((Integer) variantHash.get("order")).intValue();
						} catch (final Exception e) {
							e.printStackTrace();
						}
						if (iVariantOrder < iMinOrder) {
							iMinOrder = iVariantOrder;
							tmpHash = variantHash;

						}
					}

					if (tmpHash != null) {
						myNewVariantMaps.add(tmpHash);
						myVariantMaps.remove(tmpHash);
					}
				}

				productMap.put("colHashArtikel", myNewVariantMaps);

			}

		}

		log.info("_sortVariantsInWeraProductSetData() (E) called");
	}

