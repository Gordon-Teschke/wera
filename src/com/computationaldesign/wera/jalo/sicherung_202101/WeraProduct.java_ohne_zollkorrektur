							if (!setOfUniqueCAs.contains(ca.getCode()) && !setOfUniqueMediaName.contains(icon.getCode())) {
								// --- remember it
								setOfUniqueCAs.add(ca.getCode());
								setOfUniqueMediaName.add(icon.getCode());

								((ArrayList) ca2mediaMap.get("calist")).add(ca);
								//_debug( "found icon =" + icon.getCode());
								((ArrayList) ca2mediaMap.get("iconlist")).add(icon);
								//log.info  ( "found icon =" + icon.getCode() );
							} else {
								log.info("Eigenschaftsicon doppelt! - ignorieren " + ca.getCode());
							}
						}
					} catch (final Exception e) {
						e.printStackTrace();
					}

				} // --- if (caType != null && caType.getCode().equals("boolean"))

			} // --- for (final Iterator it3 = colProductFeatures.iterator(); it3.hasNext();)

		} catch (final Exception e) {
			e.printStackTrace();
		}

		return ca2mediaMap;
	}

