		if (res.getCount() > 0) {
		    Textbaustein oGTBaustein = null;
		    // --- Schleife �ber alle Varianten
		    for (Iterator itResult1 = res.getResult().iterator(); itResult1.hasNext();) {
			oGTBaustein = (Textbaustein) itResult1.next();
			if ( oGTBaustein != null ) {
			    sText = oGTBaustein.getText();
			    break;
			}
		    }
		}
		
	    } catch (FlexibleSearchException fse) {
		LOG.error("getGreatToolsHeadline(): ERROR using flexible search with query key "+sSearchKey);
		LOG.error(fse.getMessage());
	    }
	    return sText;
	}

